<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The MCP server. A separate console EXE on purpose: MCP clients launch it over stdio, so it needs
    no port and no token, it keeps ASP.NET Core out of the WinUI app, and it can serve reads while
    the studio is closed. It shares Larik.Core (store, secrets, paths) and the provider assemblies
    with the app, so policy and audit have one implementation.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Larik.Mcp</RootNamespace>
    <AssemblyName>Larik.Mcp</AssemblyName>
    <!--  Version is overridden from the git tag by the release workflow, like the app.  -->
    <Version>0.1.1</Version>
    <Product>Larik MCP Server</Product>
    <Company>Larik</Company>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="*" />
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Larik.Core\Larik.Core.csproj" />
    <ProjectReference Include="..\Larik.Data\Larik.Data.csproj" />
    <ProjectReference Include="..\Larik.Data.Postgres\Larik.Data.Postgres.csproj" />
    <ProjectReference Include="..\Larik.Data.SqlServer\Larik.Data.SqlServer.csproj" />
  </ItemGroup>
</Project>
