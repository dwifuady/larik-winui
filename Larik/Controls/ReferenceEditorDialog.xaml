<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Larik.Controls.ReferenceEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid
        Width="560"
        Height="360"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="SourceLabel"
            FontSize="12"
            Foreground="{ThemeResource StudioTextSecondaryBrush}"
            TextWrapping="Wrap" />

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            AutomationProperties.Name="Find reference table"
            FontSize="12"
            PlaceholderText="Find reference table"
            TextChanged="SearchBox_TextChanged" />

        <Grid
            Grid.Row="2"
            ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ListView
                    x:Name="TableList"
                    AutomationProperties.Name="Reference tables"
                    SelectionChanged="TableList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Grid
                                Padding="2,1"
                                ColumnSpacing="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="{Binding Schema}" />
                                <TextBlock
                                    Grid.Column="1"
                                    FontSize="12"
                                    Text="{Binding Name}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>

            <Border
                Grid.Column="1"
                Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource HairlineBrush}"
                BorderThickness="1"
                CornerRadius="6">
                <ListView
                    x:Name="ColumnList"
                    AutomationProperties.Name="Reference key columns"
                    SelectionChanged="ColumnList_SelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock
                                Padding="2,1"
                                FontFamily="{StaticResource StudioMonoFont}"
                                FontSize="12"
                                Text="{Binding}" />
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Grid>

        <TextBlock
            x:Name="SelectionSummary"
            Grid.Row="3"
            FontSize="11"
            Foreground="{ThemeResource StudioTextMutedBrush}"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
