<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Larik.Controls.SchemaBrowser"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Larik.Models"
    mc:Ignorable="d">

    <UserControl.Resources>
        <DataTemplate x:Key="SchemaRowTemplate" x:DataType="models:SchemaRow">
            <Grid Height="{x:Bind RowHeight}" Padding="8,0" AutomationProperties.Name="{x:Bind DisplayLabel}" Background="{x:Bind HighlightBrush, Mode=OneWay}" ColumnSpacing="8" CornerRadius="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="14" Height="12" VerticalAlignment="Center">
                    <Grid Visibility="{x:Bind TableGlyphVisibility}">
                        <Border BorderBrush="{ThemeResource StudioTextMutedBrush}" BorderThickness="1" CornerRadius="2" />
                        <Rectangle Height="1" Margin="0,3,0,0" VerticalAlignment="Top" Fill="{ThemeResource StudioTextMutedBrush}" Opacity=".55" />
                        <Rectangle Height="1" Margin="0,7,0,0" VerticalAlignment="Top" Fill="{ThemeResource StudioTextMutedBrush}" Opacity=".55" />
                    </Grid>
                    <Rectangle Width="3" Height="10" HorizontalAlignment="Center" Fill="{ThemeResource StudioTextMutedBrush}" RadiusX="1" RadiusY="1" Visibility="{x:Bind ColumnGlyphVisibility}" />
                    <FontIcon FontSize="11" Glyph="&#xE890;" Visibility="{x:Bind ViewGlyphVisibility}" />
                    <FontIcon FontSize="11" Glyph="&#xE943;" Visibility="{x:Bind RoutineGlyphVisibility}" />
                </Grid>
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="{x:Bind LabelSize}" FontWeight="{x:Bind LabelWeight}" Foreground="{x:Bind LabelBrush}" Text="{x:Bind DisplayLabel}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="9" Foreground="{ThemeResource StudioTextMutedBrush}" Text="{x:Bind Meta}" Visibility="{x:Bind MetaVisibility}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SchemaColumnTemplate" x:DataType="models:SchemaColumnRow">
            <Grid Height="24" ColumnSpacing="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontFamily="{StaticResource StudioMonoFont}" FontSize="11" Foreground="{ThemeResource StudioTextSecondaryBrush}" Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="9.5" Foreground="{ThemeResource StudioTextMutedBrush}" Text="{x:Bind DataType}" Visibility="{x:Bind TypeVisibility}" />
                <Border Grid.Column="2" Padding="3,0" VerticalAlignment="Center" BorderBrush="{x:Bind KeyBrush}" BorderThickness="1" CornerRadius="4" ToolTipService.ToolTip="{x:Bind KeyTooltip}" Visibility="{x:Bind KeyVisibility}">
                    <TextBlock FontSize="8" Foreground="{x:Bind KeyBrush}" Text="{x:Bind Key}" />
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Padding="10,9,8,6" ColumnSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                VerticalAlignment="Center"
                CharacterSpacing="110"
                FontSize="9.5"
                FontWeight="SemiBold"
                Foreground="{ThemeResource StudioTextMutedBrush}"
                Text="SCHEMA" />

            <Button
                x:Name="PinButton"
                Grid.Column="1"
                Width="28"
                Height="28"
                AutomationProperties.Name="Pin schema browser"
                Click="PinButton_Click"
                Style="{StaticResource StudioIconButtonStyle}"
                ToolTipService.ToolTip="Pin beside the editor">
                <FontIcon FontSize="11" Glyph="&#xE840;" />
            </Button>

            <Button
                x:Name="CloseButton"
                Grid.Column="2"
                Width="28"
                Height="28"
                AutomationProperties.Name="Close schema browser"
                Click="CloseButton_Click"
                Style="{StaticResource StudioIconButtonStyle}"
                ToolTipService.ToolTip="Close (Esc)">
                <FontIcon FontSize="11" Glyph="&#xE711;" />
            </Button>
        </Grid>

        <TextBox
            x:Name="SearchBox"
            Grid.Row="1"
            Height="32"
            Margin="10,0,10,0"
            Padding="10,2"
            VerticalContentAlignment="Center"
            AutomationProperties.Name="Search schema"
            FontSize="12"
            IsSpellCheckEnabled="False"
            KeyDown="SearchBox_KeyDown"
            PlaceholderText="Search tables, views, procedures and columns"
            TextChanged="SearchBox_TextChanged" />

        <TextBlock
            x:Name="ContextText"
            Grid.Row="2"
            Margin="12,6,10,6"
            FontSize="9.5"
            Foreground="{ThemeResource StudioTextMutedBrush}"
            TextTrimming="CharacterEllipsis" />

        <Grid x:Name="Body" Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition x:Name="DetailColumn" Width="248" />
            </Grid.ColumnDefinitions>

            <Grid>
                <ListView
                    x:Name="RowList"
                    Padding="6,0,6,6"
                    AutomationProperties.Name="Schema objects"
                    DoubleTapped="RowList_DoubleTapped"
                    IsItemClickEnabled="True"
                    ItemClick="RowList_ItemClick"
                    ItemTemplate="{StaticResource SchemaRowTemplate}"
                    PreviewKeyDown="RowList_PreviewKeyDown"
                    SelectionMode="None"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <TextBlock
                    x:Name="EmptyText"
                    Margin="16,12,16,12"
                    VerticalAlignment="Top"
                    FontSize="11.5"
                    Foreground="{ThemeResource StudioTextMutedBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </Grid>

            <Border
                x:Name="Detail"
                Grid.Column="1"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel Padding="14,10,12,6" Spacing="1">
                        <TextBlock
                            x:Name="DetailTitle"
                            FontSize="13.5"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="DetailSubtitle"
                            FontSize="9.5"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            TextTrimming="CharacterEllipsis" />

                        <StackPanel
                            Margin="0,9,0,0"
                            Orientation="Horizontal"
                            Spacing="6">
                            <Button
                                x:Name="PreviewButton"
                                Height="26"
                                Padding="10,0"
                                AutomationProperties.Name="Preview 100 rows"
                                Background="{ThemeResource StudioAccentBrush}"
                                Click="PreviewButton_Click"
                                CornerRadius="6"
                                FontSize="10"
                                Foreground="{ThemeResource StudioOnAccentBrush}">
                                Preview 100 rows
                            </Button>
                            <Button
                                x:Name="CopyButton"
                                Height="26"
                                Padding="8,0"
                                AutomationProperties.Name="Copy object name"
                                Click="CopyButton_Click"
                                CornerRadius="6"
                                FontSize="10"
                                Style="{StaticResource StudioIconButtonStyle}">
                                Copy name
                            </Button>
                        </StackPanel>
                    </StackPanel>

                    <ScrollViewer
                        Grid.Row="1"
                        Padding="14,2,10,10"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            x:Name="ColumnList"
                            ItemTemplate="{StaticResource SchemaColumnTemplate}" />
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <TextBlock
            x:Name="Footer"
            Grid.Row="4"
            Margin="12,0,10,8"
            FontSize="9"
            Foreground="{ThemeResource StudioTextMutedBrush}"
            Text="↑↓ Move · Enter Insert · Shift+Enter Preview · Esc Close"
            TextWrapping="Wrap" />
    </Grid>
</UserControl>
