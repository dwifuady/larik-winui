<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Larik.Controls.SqlEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Larik.Models"
    mc:Ignorable="d">

    <!--  One implementation of IEditorSurface: RichEditBox + a caret-anchored suggestion popup.  -->
    <Grid>
        <Border
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!--  Line numbers scroll with the editor; the gutter is decoration, not a tab stop.  -->
                <Border
                    Grid.Column="0"
                    Background="{ThemeResource HairlineSubtleBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,1,0"
                    CornerRadius="8,0,0,8">
                    <ScrollViewer
                        x:Name="LineNumberScroller"
                        Width="20"
                        HorizontalScrollBarVisibility="Disabled"
                        HorizontalScrollMode="Disabled"
                        IsHitTestVisible="False"
                        VerticalScrollBarVisibility="Hidden"
                        VerticalScrollMode="Enabled">
                        <TextBlock
                            x:Name="LineNumbers"
                            Margin="0,12,6,12"
                            FontFamily="{StaticResource StudioMonoFont}"
                            FontSize="13"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            LineStackingStrategy="BlockLineHeight"
                            Text="1"
                            TextAlignment="Right"
                            TextWrapping="NoWrap" />
                    </ScrollViewer>
                </Border>

                <RichEditBox
                    x:Name="Editor"
                    Grid.Column="1"
                    Padding="14,12,14,12"
                    AcceptsReturn="True"
                    AutomationProperties.Name="SQL editor"
                    Background="Transparent"
                    BorderThickness="0"
                    DisabledFormattingAccelerators="All"
                    FontFamily="{StaticResource StudioMonoFont}"
                    FontSize="13"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    LostFocus="Editor_LostFocus"
                    PlaceholderText="Type SQL — try  sel  then Tab"
                    PreviewKeyDown="Editor_PreviewKeyDown"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="Editor_SelectionChanged"
                    SelectionHighlightColor="{ThemeResource EditorSelectionBrush}"
                    TextChanged="Editor_TextChanged"
                    TextWrapping="NoWrap">
                    <!--
                        The control template paints its own fill on top of the card, including a
                        different fill when focused. Let the card surface own the background instead.
                    -->
                    <RichEditBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                    </RichEditBox.Resources>
                </RichEditBox>
            </Grid>
        </Border>

        <!--
            Find/replace floats over the top of the text instead of pushing it down, so opening it
            never reflows the document the caret is in. Ctrl+F shows the find row; Ctrl+H opens it
            with replace revealed.
        -->
        <Border
            x:Name="FindBar"
            Width="420"
            Margin="0,10,20,0"
            Padding="10,8"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <StackPanel Spacing="6">
                <Grid ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="FindBox"
                        Height="28"
                        Padding="8,2"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="Find text"
                        FontSize="12"
                        KeyDown="FindBox_KeyDown"
                        PlaceholderText="Find"
                        TextChanged="FindBox_TextChanged" />

                    <TextBlock
                        x:Name="FindCountText"
                        Grid.Column="1"
                        MinWidth="58"
                        VerticalAlignment="Center"
                        AutomationProperties.LiveSetting="Polite"
                        FontSize="11"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        TextAlignment="Right" />

                    <Button
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Toggle replace"
                        Click="ToggleReplace_Click"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Replace (Ctrl+H)">
                        <FontIcon x:Name="ReplaceChevron" FontSize="9" Glyph="&#xE76C;" />
                    </Button>

                    <Button
                        Grid.Column="3"
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Previous match"
                        Click="FindPrevious_Click"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Previous match (Shift+Enter)">
                        <FontIcon FontSize="9" Glyph="&#xE70E;" />
                    </Button>

                    <Button
                        Grid.Column="4"
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Next match"
                        Click="FindNext_Click"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Next match (Enter)">
                        <FontIcon FontSize="9" Glyph="&#xE70D;" />
                    </Button>

                    <Button
                        Grid.Column="5"
                        Width="24"
                        Height="24"
                        AutomationProperties.Name="Close find"
                        Click="CloseFind_Click"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon FontSize="9" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <Grid
                    x:Name="ReplaceRow"
                    ColumnSpacing="4"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="ReplaceBox"
                        Height="28"
                        Padding="8,2"
                        VerticalContentAlignment="Center"
                        AutomationProperties.Name="Replace text"
                        FontSize="12"
                        KeyDown="ReplaceBox_KeyDown"
                        PlaceholderText="Replace with" />

                    <Button
                        Grid.Column="1"
                        Height="24"
                        Padding="8,0"
                        AutomationProperties.Name="Replace current match"
                        Click="Replace_Click"
                        CornerRadius="6"
                        FontSize="11"
                        Style="{StaticResource StudioIconButtonStyle}"
                        Content="Replace" />

                    <Button
                        Grid.Column="2"
                        Height="24"
                        Padding="8,0"
                        AutomationProperties.Name="Replace all matches"
                        Click="ReplaceAll_Click"
                        CornerRadius="6"
                        FontSize="11"
                        Style="{StaticResource StudioIconButtonStyle}"
                        Content="Replace all" />
                </Grid>
            </StackPanel>
        </Border>

        <!--  Completion popup (caret-anchored)  -->
        <Popup
            x:Name="CompletionPopup"
            IsLightDismissEnabled="False"
            ShouldConstrainToRootBounds="True">
            <Border
                Width="392"
                MaxHeight="268"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ListView
                    x:Name="CompletionList"
                    Padding="4"
                    AutomationProperties.Name="SQL suggestions"
                    IsItemClickEnabled="True"
                    IsTabStop="False"
                    ItemClick="CompletionList_ItemClick"
                    SelectionMode="None"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemContainerStyle>
                        <!--  Rows fill the popup; the row template owns its own 8px inset.  -->
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CompletionItem">
                            <Grid
                                Height="32"
                                Padding="8,0"
                                AutomationProperties.HelpText="{x:Bind Detail}"
                                AutomationProperties.Name="{x:Bind Label}"
                                Background="{x:Bind HighlightBrush, Mode=OneWay}"
                                ColumnSpacing="8"
                                CornerRadius="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="{x:Bind KindLabel}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource StudioMonoFont}"
                                    FontSize="12"
                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                    Text="{x:Bind Label}" />

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="{x:Bind Detail}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="Tab" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Popup>
    </Grid>
</UserControl>
