<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Larik.Controls.ResultsGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Larik.Controls"
    AutomationProperties.Name="Results grid"
    Background="Transparent"
    IsTabStop="True"
    PreviewKeyDown="ResultsGrid_KeyDown"
    UseSystemFocusVisuals="False">

    <UserControl.Resources>
        <DataTemplate x:Key="ResultsRowTemplate">
            <local:ResultRowView />
        </DataTemplate>

        <Style x:Key="ResultsRowItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Stretch"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Row-number gutter mirrors the row list's vertical scroll; each item is one row.  -->
        <Style x:Key="RowNumberItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RowNumberTemplate">
            <TextBlock
                Margin="0,0,10,0"
                VerticalAlignment="Center"
                FontFamily="{StaticResource StudioMonoFont}"
                FontSize="10"
                Foreground="{ThemeResource StudioTextMutedBrush}"
                Text="{Binding}"
                TextAlignment="Right" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Empty corner above the row-number gutter, aligned with the column header.  -->
        <Border
            x:Name="RowNumberHeader"
            Grid.Row="0"
            Grid.Column="0"
            Width="28"
            Height="30"
            Background="{ThemeResource HairlineSubtleBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Visibility="Collapsed">
            <TextBlock
                Margin="0,0,10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                FontFamily="{StaticResource StudioMonoFont}"
                FontSize="10"
                Foreground="{ThemeResource StudioTextMutedBrush}"
                Text="#" />
        </Border>

        <!--  Sticky column header; its horizontal offset follows the row scroller.  -->
        <ScrollViewer
            x:Name="HeaderScroller"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalContentAlignment="Left"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            ViewChanged="HeaderScroller_ViewChanged">
            <Grid x:Name="HeaderContent" HorizontalAlignment="Left">
                <StackPanel
                    x:Name="HeaderHost"
                    HorizontalAlignment="Left"
                    Orientation="Horizontal" />
                <Border
                    x:Name="ColumnDropIndicator"
                    Width="2"
                    HorizontalAlignment="Left"
                    Background="{ThemeResource StudioAccentBrush}"
                    IsHitTestVisible="False"
                    Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>

        <Border
            x:Name="AccentRule"
            Grid.Row="0"
            Grid.ColumnSpan="2"
            Height="2"
            VerticalAlignment="Bottom"
            Opacity="0.7" />

        <!--  The native command a provider actually ran, for engines that translate the editor text.  -->
        <Border
            x:Name="GeneratedQueryBar"
            Grid.Row="1"
            Grid.ColumnSpan="2"
            Padding="12,2"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="GeneratedQueryToggle"
                        Padding="0,4"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="Generated query"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="GeneratedQueryToggle_Click"
                        ToolTipService.ToolTip="The native command sent to the database">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon
                                x:Name="GeneratedQueryChevron"
                                VerticalAlignment="Center"
                                FontSize="9"
                                Glyph="&#xE70D;" />
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Text="Generated query" />
                        </StackPanel>
                    </Button>

                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="native command" />

                    <Button
                        x:Name="GeneratedQueryCopy"
                        Grid.Column="2"
                        Width="28"
                        Height="24"
                        AutomationProperties.Name="Copy generated query"
                        Click="CopyGeneratedQuery_Click"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Copy the generated query">
                        <FontIcon FontSize="11" Glyph="&#xE8C8;" />
                    </Button>
                </Grid>

                <ScrollViewer
                    x:Name="GeneratedQueryScroll"
                    Grid.Row="1"
                    MaxHeight="180"
                    Padding="0,2,0,6"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Auto"
                    VerticalScrollMode="Auto"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="GeneratedQueryText"
                        FontFamily="{StaticResource StudioMonoFont}"
                        FontSize="12"
                        Foreground="{ThemeResource StudioTextPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!--  Row numbers are sticky horizontally and scroll with the rows vertically.  -->
        <ListView
            x:Name="RowNumberList"
            Grid.Row="2"
            Grid.Column="0"
            Width="28"
            Padding="0"
            AutomationProperties.Name="Row numbers"
            Background="Transparent"
            ContainerContentChanging="RowNumberList_ContainerContentChanging"
            IsTabStop="False"
            ItemContainerStyle="{StaticResource RowNumberItemStyle}"
            ItemTemplate="{StaticResource RowNumberTemplate}"
            Loaded="RowNumberList_Loaded"
            SelectionMode="None"
            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
            ScrollViewer.HorizontalScrollMode="Disabled"
            ScrollViewer.IsDeferredScrollingEnabled="False"
            ScrollViewer.VerticalScrollBarVisibility="Hidden"
            ScrollViewer.VerticalScrollMode="Enabled"
            Visibility="Collapsed" />

        <!--  Virtualized rows: only visible rows have TextBlocks.  -->
        <ListView
            x:Name="RowsList"
            Grid.Row="2"
            Grid.Column="1"
            Padding="0"
            AutomationProperties.HelpText="Use the arrow keys to move between cells, Ctrl+C to copy, Ctrl+Shift+C to copy with headers."
            AutomationProperties.Name="Query results"
            ItemContainerStyle="{StaticResource ResultsRowItemStyle}"
            ItemTemplate="{StaticResource ResultsRowTemplate}"
            Loaded="RowsList_Loaded"
            SelectionMode="None"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.IsDeferredScrollingEnabled="False"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollMode="Enabled">
            <ListView.ContextFlyout>
                <MenuFlyout Opening="ResultsMenu_Opening">
                    <MenuFlyoutItem
                        Click="PreviewCell_Click"
                        AutomationProperties.Name="Preview cell"
                        KeyboardAcceleratorTextOverride="Space"
                        Text="Preview cell" />
                    <MenuFlyoutItem
                        x:Name="SetReferenceMenuItem"
                        Click="SetReference_Click"
                        AutomationProperties.Name="Set custom reference"
                        Text="Set custom reference…"
                        Visibility="Collapsed" />
                    <MenuFlyoutItem
                        x:Name="RemoveReferenceMenuItem"
                        Click="RemoveReference_Click"
                        AutomationProperties.Name="Remove custom reference"
                        Text="Remove custom reference"
                        Visibility="Collapsed" />
                    <MenuFlyoutItem
                        Click="Export_Click"
                        AutomationProperties.Name="Export results"
                        Text="Export results…" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Click="Copy_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+C"
                        Text="Copy" />
                    <MenuFlyoutItem
                        Click="CopyWithHeaders_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                        Text="Copy with headers" />
                    <MenuFlyoutItem
                        Click="CopyAsInsert_Click"
                        AutomationProperties.Name="Copy as INSERT"
                        Text="Copy as INSERT" />
                    <MenuFlyoutItem
                        Click="CopyAsInClause_Click"
                        AutomationProperties.Name="Copy as IN clause"
                        Text="Copy as IN clause" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Click="SelectAll_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+A"
                        Text="Select all" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="2"
            Grid.Column="1"
            Margin="14,12,14,12"
            FontSize="12"
            Foreground="{ThemeResource StudioTextMutedBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!--  Server messages (PRINT, statistics, warnings) as selectable monospace text.  -->
        <ScrollViewer
            x:Name="MessagesScroll"
            Grid.Row="2"
            Grid.Column="1"
            Padding="14,12"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            Visibility="Collapsed">
            <TextBlock
                x:Name="MessagesText"
                FontFamily="{StaticResource StudioMonoFont}"
                FontSize="12"
                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
        </ScrollViewer>

        <!--  Cell preview: Space on a cell, or the context menu, shows the full value.  -->
        <Grid
            x:Name="PreviewHost"
            Grid.RowSpan="3"
            Grid.Column="2"
            Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <local:SideDragHandle
                x:Name="PreviewResizeHandle"
                Margin="0"
                Background="Transparent"
                PointerCaptureLost="PreviewResizeHandle_PointerCaptureLost"
                PointerMoved="PreviewResizeHandle_PointerMoved"
                PointerPressed="PreviewResizeHandle_PointerPressed"
                PointerReleased="PreviewResizeHandle_PointerReleased">
                <Border
                    Width="1"
                    HorizontalAlignment="Center"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </local:SideDragHandle>

            <Border
                x:Name="CellPreview"
                Grid.Column="1"
                Width="340"
                AutomationProperties.Name="Cell preview"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Padding="12,8,8,6" ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center" Spacing="1">
                            <TextBlock
                                x:Name="CellPreviewTitle"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="CellPreviewSubtitle"
                                FontSize="10"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button
                            x:Name="ReferenceToggleButton"
                            Grid.Column="1"
                            Width="28"
                            Height="28"
                            AutomationProperties.Name="Preview referenced row"
                            Click="ReferenceToggle_Click"
                            Style="{StaticResource StudioIconButtonStyle}"
                            ToolTipService.ToolTip="Preview referenced rows (Shift+Space)"
                            Visibility="Collapsed">
                            <FontIcon FontSize="11" Glyph="&#xE71B;" />
                        </Button>

                        <Button
                            x:Name="PreviewFormatButton"
                            Grid.Column="2"
                            Height="28"
                            Padding="6,0"
                            AutomationProperties.Name="Cell preview format"
                            Style="{StaticResource StudioIconButtonStyle}"
                            ToolTipService.ToolTip="Auto-format JSON and XML">
                            <Button.Flyout>
                                <MenuFlyout>
                                    <MenuFlyoutItem Click="FormatAuto_Click" Text="Auto" />
                                    <MenuFlyoutItem Click="FormatJson_Click" Text="JSON" />
                                    <MenuFlyoutItem Click="FormatXml_Click" Text="XML" />
                                    <MenuFlyoutItem Click="FormatPlain_Click" Text="Plain" />
                                </MenuFlyout>
                            </Button.Flyout>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="3">
                                <TextBlock
                                    x:Name="PreviewFormatLabel"
                                    FontSize="10"
                                    Text="Auto" />
                                <FontIcon FontSize="8" Glyph="&#xE70D;" />
                            </StackPanel>
                        </Button>

                        <Button
                            Grid.Column="3"
                            Width="28"
                            Height="28"
                            AutomationProperties.Name="Copy cell value"
                            Click="CopyPreview_Click"
                            Style="{StaticResource StudioIconButtonStyle}"
                            ToolTipService.ToolTip="Copy the value">
                            <FontIcon FontSize="11" Glyph="&#xE8C8;" />
                        </Button>

                        <Button
                            Grid.Column="4"
                            Width="28"
                            Height="28"
                            AutomationProperties.Name="Close cell preview"
                            Click="ClosePreview_Click"
                            Style="{StaticResource StudioIconButtonStyle}"
                            ToolTipService.ToolTip="Close (Esc)">
                            <FontIcon FontSize="11" Glyph="&#xE711;" />
                        </Button>
                    </Grid>

                    <ScrollViewer
                        x:Name="ValueView"
                        Grid.Row="1"
                        Padding="12,4,12,10"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="CellPreviewValue"
                            FontFamily="{StaticResource StudioMonoFont}"
                            FontSize="12"
                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                            IsTextSelectionEnabled="True"
                            TextWrapping="Wrap" />
                    </ScrollViewer>

                    <Grid
                        x:Name="ReferenceView"
                        Grid.Row="1"
                        AutomationProperties.Name="Reference preview"
                        Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock
                            x:Name="ReferenceSummary"
                            Margin="12,4,12,6"
                            FontSize="10"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            TextWrapping="Wrap" />

                        <Grid Grid.Row="1">
                            <local:ReferenceTableView
                                x:Name="ReferenceTable"
                                Visibility="Collapsed" />
                            <local:ReferenceRecordsView
                                x:Name="ReferenceRecords"
                                Visibility="Collapsed" />

                            <TextBlock
                                x:Name="ReferenceStatus"
                                Margin="14,10,14,10"
                                FontSize="11.5"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </Grid>

                        <TextBlock
                            x:Name="ReferenceFooter"
                            Grid.Row="2"
                            Margin="12,6,12,10"
                            FontSize="10"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <TextBlock
                        x:Name="CellPreviewFooter"
                        Grid.Row="2"
                        Margin="12,0,12,10"
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
