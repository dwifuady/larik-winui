<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Larik.Controls.ResultsGrid"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Larik.Controls"
    AutomationProperties.Name="Results grid"
    Background="Transparent"
    IsTabStop="True"
    PreviewKeyDown="ResultsGrid_KeyDown"
    UseSystemFocusVisuals="False">

    <UserControl.Resources>
        <DataTemplate x:Key="ResultsRowTemplate">
            <local:ResultRowView />
        </DataTemplate>

        <Style x:Key="ResultsRowItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <ContentPresenter
                            HorizontalContentAlignment="Left"
                            VerticalContentAlignment="Stretch"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Sticky column header; its horizontal offset follows the row scroller.  -->
        <ScrollViewer
            x:Name="HeaderScroller"
            HorizontalContentAlignment="Left"
            HorizontalScrollBarVisibility="Hidden"
            HorizontalScrollMode="Enabled"
            VerticalScrollBarVisibility="Disabled"
            VerticalScrollMode="Disabled"
            ViewChanged="HeaderScroller_ViewChanged">
            <StackPanel
                x:Name="HeaderHost"
                HorizontalAlignment="Left"
                Orientation="Horizontal" />
        </ScrollViewer>

        <Border
            x:Name="AccentRule"
            Grid.Row="0"
            Height="2"
            VerticalAlignment="Bottom"
            Opacity="0.7" />

        <!--  Virtualized rows: only visible rows have TextBlocks.  -->
        <ListView
            x:Name="RowsList"
            Grid.Row="1"
            Padding="0"
            AutomationProperties.HelpText="Use the arrow keys to move between cells, Ctrl+C to copy, Ctrl+Shift+C to copy with headers."
            AutomationProperties.Name="Query results"
            ItemContainerStyle="{StaticResource ResultsRowItemStyle}"
            ItemTemplate="{StaticResource ResultsRowTemplate}"
            Loaded="RowsList_Loaded"
            SelectionMode="None"
            ScrollViewer.HorizontalScrollBarVisibility="Auto"
            ScrollViewer.HorizontalScrollMode="Enabled"
            ScrollViewer.IsDeferredScrollingEnabled="False"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            ScrollViewer.VerticalScrollMode="Enabled">
            <ListView.ContextFlyout>
                <MenuFlyout>
                    <MenuFlyoutItem
                        Click="PreviewCell_Click"
                        AutomationProperties.Name="Preview cell"
                        KeyboardAcceleratorTextOverride="Space"
                        Text="Preview cell" />
                    <MenuFlyoutItem
                        Click="Export_Click"
                        AutomationProperties.Name="Export results"
                        Text="Export results…" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Click="Copy_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+C"
                        Text="Copy" />
                    <MenuFlyoutItem
                        Click="CopyWithHeaders_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+Shift+C"
                        Text="Copy with headers" />
                    <MenuFlyoutSeparator />
                    <MenuFlyoutItem
                        Click="SelectAll_Click"
                        KeyboardAcceleratorTextOverride="Ctrl+A"
                        Text="Select all" />
                </MenuFlyout>
            </ListView.ContextFlyout>
        </ListView>

        <TextBlock
            x:Name="EmptyText"
            Grid.Row="1"
            Margin="14,12,14,12"
            FontSize="12"
            Foreground="{ThemeResource StudioTextMutedBrush}"
            TextWrapping="Wrap"
            Visibility="Collapsed" />

        <!--  Server messages (PRINT, statistics, warnings) as selectable monospace text.  -->
        <ScrollViewer
            x:Name="MessagesScroll"
            Grid.Row="1"
            Padding="14,12"
            HorizontalScrollBarVisibility="Auto"
            HorizontalScrollMode="Auto"
            VerticalScrollBarVisibility="Auto"
            VerticalScrollMode="Auto"
            Visibility="Collapsed">
            <TextBlock
                x:Name="MessagesText"
                FontFamily="{StaticResource StudioMonoFont}"
                FontSize="12"
                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                IsTextSelectionEnabled="True"
                TextWrapping="Wrap" />
        </ScrollViewer>

        <!--  Cell preview: Space on a cell, or the context menu, shows the full value.  -->
        <Border
            x:Name="CellPreview"
            Grid.RowSpan="2"
            Grid.Column="1"
            Width="340"
            Margin="8,0,0,0"
            AutomationProperties.Name="Cell preview"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Visibility="Collapsed">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Padding="12,8,8,6" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock
                            x:Name="CellPreviewTitle"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="CellPreviewSubtitle"
                            FontSize="10"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <Button
                        Grid.Column="1"
                        Width="28"
                        Height="28"
                        AutomationProperties.Name="Copy cell value"
                        Click="CopyPreview_Click"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Copy the full value">
                        <FontIcon FontSize="11" Glyph="&#xE8C8;" />
                    </Button>

                    <Button
                        Grid.Column="2"
                        Width="28"
                        Height="28"
                        AutomationProperties.Name="Close cell preview"
                        Click="ClosePreview_Click"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Close (Esc)">
                        <FontIcon FontSize="11" Glyph="&#xE711;" />
                    </Button>
                </Grid>

                <ScrollViewer
                    Grid.Row="1"
                    Padding="12,4,12,10"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <TextBlock
                        x:Name="CellPreviewValue"
                        FontFamily="{StaticResource StudioMonoFont}"
                        FontSize="12"
                        Foreground="{ThemeResource StudioTextPrimaryBrush}"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap" />
                </ScrollViewer>

                <TextBlock
                    x:Name="CellPreviewFooter"
                    Grid.Row="2"
                    Margin="12,0,12,10"
                    FontSize="10"
                    Foreground="{ThemeResource StudioTextMutedBrush}"
                    TextWrapping="Wrap" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
