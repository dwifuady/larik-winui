<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="Larik.Controls.NoteEditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="NoteKindPillStyle" TargetType="Button">
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{ThemeResource StudioTextMutedBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <Style
            x:Key="NoteKindPillSelectedStyle"
            BasedOn="{StaticResource NoteKindPillStyle}"
            TargetType="Button">
            <Setter Property="Background" Value="{ThemeResource StudioAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource StudioAccentBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource StudioTextPrimaryBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="NoteRoot"
        Padding="12,10,12,0"
        AutomationProperties.Name="Note editor"
        KeyDown="Root_KeyDown"
        RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  Kind is the only decision on the surface; it describes the note, not the query.  -->
        <Grid ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" Spacing="3">
                <Button
                    x:Name="NoteKindButton"
                    AutomationProperties.Name="Note kind - note"
                    Click="Kind_Click"
                    Style="{StaticResource NoteKindPillSelectedStyle}"
                    Tag="Note">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="10" Glyph="&#xE90A;" />
                        <TextBlock FontSize="11" Text="Note" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="TodoKindButton"
                    AutomationProperties.Name="Note kind - todo"
                    Click="Kind_Click"
                    Style="{StaticResource NoteKindPillStyle}"
                    Tag="Todo">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="10" Glyph="&#xE73E;" />
                        <TextBlock FontSize="11" Text="TODO" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="DecisionKindButton"
                    AutomationProperties.Name="Note kind - decision"
                    Click="Kind_Click"
                    Style="{StaticResource NoteKindPillStyle}"
                    Tag="Decision">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="10" Glyph="&#xE735;" />
                        <TextBlock FontSize="11" Text="Decision" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="ObservationKindButton"
                    AutomationProperties.Name="Note kind - observation"
                    Click="Kind_Click"
                    Style="{StaticResource NoteKindPillStyle}"
                    Tag="Observation">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <FontIcon FontSize="10" Glyph="&#xE946;" />
                        <TextBlock FontSize="11" Text="Observation" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel
                Grid.Column="1"
                Orientation="Horizontal"
                Spacing="2">
                <Button
                    x:Name="DeleteButton"
                    Width="26"
                    Height="26"
                    AutomationProperties.Name="Delete note"
                    Click="Delete_Click"
                    Style="{StaticResource StudioIconButtonStyle}"
                    ToolTipService.ToolTip="Delete note">
                    <FontIcon FontSize="11" Glyph="&#xE74D;" />
                </Button>
                <Button
                    x:Name="CloseButton"
                    Width="26"
                    Height="26"
                    AutomationProperties.Name="Close note editor"
                    Click="Close_Click"
                    Style="{StaticResource StudioIconButtonStyle}"
                    ToolTipService.ToolTip="Close (Esc)">
                    <FontIcon FontSize="10" Glyph="&#xE711;" />
                </Button>
            </StackPanel>
        </Grid>

        <!--  The quote is the anchor made visible: what the note is attached to, not a summary.  -->
        <Border
            Grid.Row="1"
            Padding="7,4"
            Background="{ThemeResource HairlineSubtleBrush}"
            BorderBrush="{ThemeResource StudioAccentBrush}"
            BorderThickness="2,0,0,0"
            CornerRadius="0,4,4,0"
            Visibility="{x:Bind QuoteVisibility}">
            <TextBlock
                x:Name="QuoteText"
                FontFamily="{StaticResource StudioMonoFont}"
                FontSize="11"
                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="NoWrap" />
        </Border>

        <StackPanel
            Grid.Row="2"
            Orientation="Horizontal"
            Spacing="5">
            <FontIcon
                FontSize="9"
                Foreground="{ThemeResource StudioTextMutedBrush}"
                Glyph="&#xE840;" />
            <TextBlock
                x:Name="AnchorText"
                FontSize="10"
                Foreground="{ThemeResource StudioTextMutedBrush}"
                TextTrimming="CharacterEllipsis" />
        </StackPanel>

        <TextBox
            x:Name="BodyBox"
            Grid.Row="3"
            MinHeight="64"
            MaxHeight="220"
            Padding="9,7"
            AcceptsReturn="True"
            AutomationProperties.Name="Note text"
            Background="{ThemeResource ElevatedSurfaceBrush}"
            BorderBrush="{ThemeResource HairlineBrush}"
            BorderThickness="1"
            CornerRadius="6"
            FontSize="12.5"
            IsSpellCheckEnabled="True"
            KeyDown="BodyBox_KeyDown"
            PlaceholderText="Write a note…"
            ScrollViewer.VerticalScrollBarVisibility="Auto"
            TextChanged="BodyBox_TextChanged"
            TextWrapping="Wrap" />

        <Grid
            Grid.Row="4"
            Height="32"
            Margin="-12,0,-12,0"
            Padding="12,0"
            Background="{ThemeResource HairlineSubtleBrush}"
            ColumnSpacing="6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <FontIcon
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="{ThemeResource StudioSuccessBrush}"
                Glyph="&#xE73E;" />
            <TextBlock
                Grid.Column="1"
                Margin="5,0,0,0"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="{ThemeResource StudioTextMutedBrush}"
                Text="Saved automatically" />

            <Border
                Grid.Column="2"
                Padding="4,1"
                VerticalAlignment="Center"
                Background="{ThemeResource HairlineBrush}"
                CornerRadius="3">
                <TextBlock
                    FontSize="9"
                    Foreground="{ThemeResource StudioTextMutedBrush}"
                    Text="Esc" />
            </Border>
            <TextBlock
                Grid.Column="3"
                VerticalAlignment="Center"
                FontSize="10"
                Foreground="{ThemeResource StudioTextMutedBrush}"
                Text="close" />
        </Grid>
    </Grid>
</UserControl>
