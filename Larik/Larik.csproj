<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Larik</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\AppIcon.ico')">Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <!--  Version is overridden from the git tag by the release workflow.  -->
    <Version>0.1.1</Version>
    <Product>Larik</Product>
    <Company>Larik</Company>
  </PropertyGroup>

  <!--
    CopyToOutputDirectory matters for unpackaged (portable) builds: without it
    the MSIX layout still gets these files, but `dotnet publish` leaves them out,
    so the window icon and tile assets are missing at runtime.
  -->
  <ItemGroup>
    <Content Include="Assets\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--  License notices ship next to the app, in both the ZIP and the installer.  -->
  <ItemGroup>
    <Content Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    The Store workflow writes obj\store\Package.appxmanifest from Partner Center's identity before
    packaging. Use it instead of the dev manifest so the identity is never guessed.
  -->
  <ItemGroup Condition="'$(Configuration)' == 'Store'">
    <AppxManifest Remove="Package.appxmanifest" />
    <AppxManifest Include="obj\store\Package.appxmanifest" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="*" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="*" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="*" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Larik.Core\Larik.Core.csproj" />
    <ProjectReference Include="..\Larik.Data\Larik.Data.csproj" />
    <ProjectReference Include="..\Larik.Data.Postgres\Larik.Data.Postgres.csproj" />
    <ProjectReference Include="..\Larik.Data.SqlServer\Larik.Data.SqlServer.csproj" />
  </ItemGroup>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <!--
    Trimming is not supported for WinUI 3 / XAML: it can strip x:Bind and WinRT
    interop, producing a package that builds clean and fails at runtime. Release
    builds are always self-contained so the portable ZIP needs no installed .NET
    runtime.
  -->
  <PropertyGroup Condition="'$(Configuration)' != 'Debug'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <!--
    Microsoft Store configuration: the Store package ships only the built-in providers. It never
    scans Plugins, never downloads a driver, and hides the Drivers page. The GitHub build keeps
    the add-on surface. Keep this flag out of runtime logic: provider differences still come from
    the contracts.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Store'">
    <DefineConstants>$(DefineConstants);LARIK_STORE</DefineConstants>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>

  <!--
    The MCP server is a second apphost, not a library: agents launch it themselves. It is built
    before this project's layout and copied beside Larik.exe, which is what lets the packaged build
    declare an execution alias and what makes the Settings snippet a real path in a developer build.
    Publish repeats the copy from a self-contained build (see PublishMcpServer) so an installed copy
    needs no .NET runtime of its own.
  -->
  <Target Name="BuildMcpServerLayout" BeforeTargets="CopyMcpServer">
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\Larik.Mcp\Larik.Mcp.csproj"
      Targets="Build"
      Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CopyMcpServer" AfterTargets="Build" Condition="'$(NoBuild)' != 'true'">
    <ItemGroup>
      <McpServerFile Include="$(MSBuildProjectDirectory)\..\Larik.Mcp\bin\$(Configuration)\net10.0\*.dll" />
      <McpServerFile Include="$(MSBuildProjectDirectory)\..\Larik.Mcp\bin\$(Configuration)\net10.0\*.exe" />
      <McpServerFile Include="$(MSBuildProjectDirectory)\..\Larik.Mcp\bin\$(Configuration)\net10.0\*.json" />
    </ItemGroup>
    <Copy
      SourceFiles="@(McpServerFile)"
      DestinationFolder="$(OutDir)"
      SkipUnchangedFiles="true" />
    <!-- The packaged layout is a copy of the output made by the MSIX tooling; the alias in
         Package.appxmanifest points at Larik.Mcp.exe inside it, so it has to be there too. -->
    <Copy
      Condition="Exists('$(OutDir)AppX')"
      SourceFiles="@(McpServerFile)"
      DestinationFolder="$(OutDir)AppX"
      SkipUnchangedFiles="true" />
  </Target>

  <Target Name="PublishMcpServer" AfterTargets="Publish">
    <MSBuild
      Projects="$(MSBuildProjectDirectory)\..\Larik.Mcp\Larik.Mcp.csproj"
      Targets="Publish"
      Properties="Configuration=$(Configuration);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);PublishDir=$(PublishDir)" />
  </Target>
</Project>
