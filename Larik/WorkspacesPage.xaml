<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Larik.WorkspacesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Larik.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  A manager row is a full-width object, not a selectable item; drag reordering stays.  -->
        <Style x:Key="WorkspaceRowItemStyle" TargetType="ListViewItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="WorkspacesTitleBar"
            Grid.Row="0"
            Title="Workspaces"
            BackRequested="WorkspacesTitleBar_BackRequested"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <Grid
            Grid.Row="1"
            MaxWidth="1100"
            Padding="24,12,24,20"
            HorizontalAlignment="Stretch"
            RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  One primary action: a new workspace. The list below is the collection.  -->
            <Grid Grid.Row="0" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        x:Name="SummaryText"
                        FontSize="12"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="Loading workspaces…"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="New workspace"
                    Click="NewWorkspace_Click"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon FontSize="11" Glyph="&#xE710;" />
                        <TextBlock Text="New workspace" />
                    </StackPanel>
                </Button>
            </Grid>

            <Border
                Grid.Row="1"
                Padding="0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <ListView
                        x:Name="WorkspaceList"
                        AllowDrop="True"
                        AutomationProperties.Name="Workspaces"
                        CanDragItems="True"
                        CanReorderItems="True"
                        IsItemClickEnabled="False"
                        ItemContainerStyle="{StaticResource WorkspaceRowItemStyle}"
                        ReorderMode="Enabled"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:SpaceViewModel">
                                <Grid
                                    Height="64"
                                    Padding="10,0"
                                    ColumnSpacing="10"
                                    AutomationProperties.HelpText="{x:Bind ConnectionSummary, Mode=OneWay}"
                                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                                    Opacity="{x:Bind RowOpacity, Mode=OneWay}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Drag affordance; the whole row is the drag target.  -->
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="12"
                                        Foreground="{ThemeResource StudioTextMutedBrush}"
                                        Text="⋮⋮" />

                                    <Grid
                                        Grid.Column="1"
                                        Width="30"
                                        Height="30"
                                        VerticalAlignment="Center">
                                        <Border
                                            Background="{x:Bind ActiveTintBrush, Mode=OneWay}"
                                            CornerRadius="8" />
                                        <FontIcon
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                                            Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                                            Visibility="{x:Bind IconGlyphVisibility, Mode=OneWay}" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{x:Bind AccentBrush, Mode=OneWay}"
                                            Text="{x:Bind Monogram, Mode=OneWay}"
                                            Visibility="{x:Bind MonogramVisibility, Mode=OneWay}" />
                                    </Grid>

                                    <StackPanel
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                        <Grid ColumnSpacing="7">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                                Text="{x:Bind Name, Mode=OneWay}"
                                                TextTrimming="CharacterEllipsis" />
                                            <Border
                                                Grid.Column="1"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource StudioAccentSoftBrush}"
                                                CornerRadius="3"
                                                Visibility="{x:Bind OpenBadgeVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    CharacterSpacing="60"
                                                    FontSize="8"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource StudioAccentBrush}"
                                                    Text="OPEN" />
                                            </Border>
                                            <Border
                                                Grid.Column="2"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                Background="{ThemeResource HairlineSubtleBrush}"
                                                BorderBrush="{ThemeResource HairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                Visibility="{x:Bind HiddenBadgeVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    CharacterSpacing="30"
                                                    FontSize="8"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                                    Text="HIDDEN FROM RAIL" />
                                            </Border>
                                            <Border
                                                Grid.Column="3"
                                                Padding="5,1"
                                                VerticalAlignment="Center"
                                                AutomationProperties.Name="{x:Bind SecurityWarning, Mode=OneWay}"
                                                Background="{ThemeResource HairlineSubtleBrush}"
                                                BorderBrush="{ThemeResource HairlineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="3"
                                                ToolTipService.ToolTip="{x:Bind SecurityWarning, Mode=OneWay}"
                                                Visibility="{x:Bind SecurityWarningVisibility, Mode=OneWay}">
                                                <TextBlock
                                                    CharacterSpacing="30"
                                                    FontSize="8"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource StudioWarningBrush}"
                                                    Text="UNVERIFIED" />
                                            </Border>
                                        </Grid>
                                        <TextBlock
                                            FontSize="10.5"
                                            Foreground="{ThemeResource StudioTextMutedBrush}"
                                            Text="{x:Bind ConnectionSummary, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <StackPanel
                                        Grid.Column="3"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="2">
                                        <Button
                                            Height="30"
                                            AutomationProperties.Name="{x:Bind VisibilityActionName, Mode=OneWay}"
                                            Click="ToggleVisibility_Click"
                                            Content="{x:Bind VisibilityActionLabel, Mode=OneWay}"
                                            FontSize="11"
                                            Style="{StaticResource StudioIconButtonStyle}"
                                            ToolTipService.ToolTip="{x:Bind VisibilityActionName, Mode=OneWay}" />
                                        <Button
                                            Height="30"
                                            AutomationProperties.Name="{x:Bind EditActionName, Mode=OneWay}"
                                            Click="EditWorkspace_Click"
                                            Content="Edit"
                                            FontSize="11"
                                            Style="{StaticResource StudioIconButtonStyle}"
                                            ToolTipService.ToolTip="Workspace settings" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <TextBlock
                        x:Name="EmptyText"
                        Margin="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="No workspaces yet. Create one to get started."
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <StackPanel Grid.Row="2" Spacing="3">
                <TextBlock
                    FontSize="10"
                    Foreground="{ThemeResource StudioTextMutedBrush}"
                    Text="Drag a row to set the order used by the switcher and the rail footer. Hidden workspaces keep their place in that order."
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="10"
                    Foreground="{ThemeResource StudioTextMutedBrush}"
                    Text="Hiding the open workspace keeps it open; it leaves the rail after you switch away."
                    TextWrapping="Wrap" />
                <TextBlock
                    FontSize="10"
                    Foreground="{ThemeResource StudioTextMutedBrush}"
                    Text="Delete stays inside workspace settings, confirmed, and archived tabs survive it."
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </Grid>
</Page>
