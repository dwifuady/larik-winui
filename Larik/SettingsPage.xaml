<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Larik.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Larik.Models"
    Background="Transparent"
    mc:Ignorable="d">



    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  Caption: the same drag region the shell uses, with Back in place of the pane toggle.  -->
        <TitleBar
            x:Name="SettingsTitleBar"
            Grid.Row="0"
            Title="Settings"
            BackRequested="SettingsTitleBar_BackRequested"
            IsBackButtonVisible="True"
            IsPaneToggleButtonVisible="False">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <NavigationView
            x:Name="SettingsNav"
            Grid.Row="1"
            AlwaysShowHeader="False"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            PaneDisplayMode="Left"
            SelectionChanged="SettingsNav_SelectionChanged">

            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="AppearanceNavItem" Content="Appearance" Tag="appearance">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE790;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="SnippetsNavItem" Content="Snippets" Tag="snippets">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE943;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AddonsNavItem" Content="Drivers" Tag="drivers">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE71D;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Name="AboutNavItem" Content="About" Tag="about">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE946;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid Padding="24,12,24,20">

                <!--  ============ APPEARANCE ============  -->
                <ScrollViewer
                    x:Name="AppearanceSection"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <StackPanel
                        MaxWidth="680"
                        HorizontalAlignment="Left"
                        Spacing="14">
                        <StackPanel Spacing="3">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                Text="Appearance" />
                            <TextBlock
                                FontSize="12"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="Choose the theme for the studio. The choice is remembered on this device."
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Border
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="2">
                                    <TextBlock
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                        Text="Theme" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource StudioTextMutedBrush}"
                                        Text="System follows the Windows light and dark setting."
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <RadioButtons
                                    x:Name="ThemeChoice"
                                    AutomationProperties.Name="Theme"
                                    SelectionChanged="ThemeChoice_SelectionChanged">
                                    <x:String>Use Windows setting</x:String>
                                    <x:String>Light</x:String>
                                    <x:String>Dark</x:String>
                                </RadioButtons>
                            </StackPanel>
                        </Border>

                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="Larik redraws open tabs and results immediately; nothing needs a restart."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!--  ============ DRIVERS ============  -->
                <ScrollViewer
                    x:Name="AddonsSection"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="760"
                        HorizontalAlignment="Left"
                        Spacing="14">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Spacing="3">
                                <TextBlock
                                    FontSize="20"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                    Text="Database drivers" />
                                <TextBlock
                                    x:Name="AddonStatusText"
                                    FontSize="12"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="Checking for drivers…"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="8">
                                <Button
                                    x:Name="RefreshAddonsButton"
                                    AutomationProperties.Name="Refresh drivers"
                                    Click="RefreshAddons_Click"
                                    Content="Refresh" />
                                <Button
                                    x:Name="InstallZipButton"
                                    AutomationProperties.Name="Install driver from file"
                                    Click="InstallZip_Click"
                                    Content="Install from file" />
                            </StackPanel>
                        </Grid>

                        <ProgressRing
                            x:Name="AddonProgress"
                            Width="18"
                            Height="18"
                            HorizontalAlignment="Left"
                            IsActive="False"
                            Visibility="Collapsed" />

                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                Text="Installed drivers" />
                            <StackPanel
                                x:Name="InstalledAddonPanel"
                                Spacing="4" />
                            <TextBlock
                                x:Name="InstalledEmptyText"
                                FontSize="11"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="No other drivers are installed."
                                Visibility="Collapsed" />
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                Text="Available drivers" />
                            <StackPanel
                                x:Name="AvailableAddonPanel"
                                Spacing="4" />
                            <TextBlock
                                x:Name="AvailableEmptyText"
                                FontSize="11"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="No drivers are available for this version of Larik."
                                Visibility="Collapsed" />
                        </StackPanel>

                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="Drivers are trusted code that runs inside Larik. Install only drivers you trust. Installing, updating or disabling a driver takes effect after a restart."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

                <!--  ============ SNIPPETS ============  -->
                <Grid x:Name="SnippetsSection" RowSpacing="14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Spacing="3">
                            <TextBlock
                                FontSize="20"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                Text="SQL snippets" />
                            <TextBlock
                                x:Name="SnippetCountText"
                                FontSize="12"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="Loading snippets…" />
                        </StackPanel>

                        <Button
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="New snippet"
                            Click="NewSnippet_Click"
                            Style="{StaticResource AccentButtonStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="11" Glyph="&#xE710;" />
                                <TextBlock Text="New snippet" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Grid Grid.Row="1" ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="340" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!--  Snippet list with its own search and category filter  -->
                        <Grid Grid.Column="0" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBox
                                x:Name="SearchBox"
                                AutomationProperties.Name="Search snippets"
                                PlaceholderText="Search trigger, name or SQL…"
                                TextChanged="SearchBox_TextChanged" />

                            <ComboBox
                                x:Name="CategoryFilter"
                                Grid.Row="1"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.Name="Filter by category"
                                SelectionChanged="CategoryFilter_SelectionChanged" />

                            <Grid Grid.Row="2">
                                <ListView
                                    x:Name="SnippetList"
                                    Padding="0,0,0,8"
                                    AutomationProperties.Name="Snippets"
                                    SelectionChanged="SnippetList_SelectionChanged"
                                    SelectionMode="Single">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:SnippetRecord">
                                            <Grid
                                                Height="64"
                                                Padding="8,4"
                                                ColumnSpacing="8"
                                                Opacity="{x:Bind RowOpacity}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center" Spacing="3">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <Border
                                                            Padding="5,1"
                                                            Background="{ThemeResource HairlineSubtleBrush}"
                                                            CornerRadius="3">
                                                            <TextBlock
                                                                FontFamily="{StaticResource StudioMonoFont}"
                                                                FontSize="10"
                                                                Foreground="{ThemeResource StudioAccentBrush}"
                                                                Text="{x:Bind Trigger}" />
                                                        </Border>
                                                        <TextBlock
                                                            MaxWidth="180"
                                                            FontSize="12"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                                            Text="{x:Bind Name}"
                                                            TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                    <TextBlock
                                                        FontFamily="{StaticResource StudioMonoFont}"
                                                        FontSize="10"
                                                        Foreground="{ThemeResource StudioTextMutedBrush}"
                                                        Text="{x:Bind Preview}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Right"
                                                    Spacing="3">
                                                    <Border
                                                        Padding="5,1"
                                                        HorizontalAlignment="Right"
                                                        Background="{ThemeResource HairlineSubtleBrush}"
                                                        CornerRadius="3">
                                                        <TextBlock
                                                            CharacterSpacing="60"
                                                            FontSize="8"
                                                            FontWeight="SemiBold"
                                                            Foreground="{ThemeResource StudioTextMutedBrush}"
                                                            Text="{x:Bind OriginLabel}" />
                                                    </Border>
                                                    <StackPanel
                                                        HorizontalAlignment="Right"
                                                        Orientation="Horizontal"
                                                        Spacing="4">
                                                        <TextBlock
                                                            FontSize="9"
                                                            Foreground="{ThemeResource StudioWarningBrush}"
                                                            Text="OFF"
                                                            Visibility="{x:Bind DisabledVisibility}" />
                                                        <TextBlock
                                                            FontSize="9"
                                                            Foreground="{ThemeResource StudioTextMutedBrush}"
                                                            Text="{x:Bind CategoryLabel}" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <TextBlock
                                    x:Name="EmptyListText"
                                    Margin="8,24,8,0"
                                    FontSize="12"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="No snippets match this search."
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Grid>

                        <!--  Editor  -->
                        <Border
                            Grid.Column="1"
                            Padding="18"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <TextBlock
                                    x:Name="EditorEmptyText"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="Select a snippet to edit, or create a new one."
                                    TextWrapping="Wrap"
                                    TextAlignment="Center" />

                                <Grid
                                    x:Name="EditorPanel"
                                    RowSpacing="10"
                                    Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <StackPanel Spacing="2">
                                            <TextBlock
                                                x:Name="EditorHeading"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                                Text="Edit snippet" />
                                            <TextBlock
                                                x:Name="EditorSubheading"
                                                FontSize="11"
                                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                                Text="Type the trigger in the editor and press Tab to expand." />
                                        </StackPanel>

                                        <ToggleSwitch
                                            x:Name="EnabledToggle"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            AutomationProperties.Name="Snippet enabled"
                                            OffContent="Disabled"
                                            OnContent="Enabled"
                                            Toggled="EnabledToggle_Toggled" />
                                    </Grid>

                                    <Grid Grid.Row="1" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <TextBox
                                            x:Name="TriggerBox"
                                            AutomationProperties.Name="Trigger"
                                            CharacterCasing="Lower"
                                            Header="Trigger"
                                            PlaceholderText="e.g. sel, ins, myq" />

                                        <TextBox
                                            x:Name="NameBox"
                                            Grid.Column="1"
                                            AutomationProperties.Name="Name"
                                            Header="Name"
                                            PlaceholderText="SELECT statement" />
                                    </Grid>

                                    <TextBox
                                        x:Name="CategoryBox"
                                        Grid.Row="2"
                                        AutomationProperties.Name="Category"
                                        Header="Category"
                                        PlaceholderText="Select, Insert, DDL…" />

                                    <StackPanel Grid.Row="3" Spacing="5">
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                            Text="Databases" />
                                        <StackPanel
                                            x:Name="DialectChips"
                                            Orientation="Horizontal"
                                            Spacing="6" />
                                        <TextBlock
                                            FontSize="10"
                                            Foreground="{ThemeResource StudioTextMutedBrush}"
                                            Text="Only suggested in editors connected to the selected databases." />
                                    </StackPanel>

                                    <TextBox
                                        x:Name="DescriptionBox"
                                        Grid.Row="4"
                                        AutomationProperties.Name="Description"
                                        Header="Description"
                                        PlaceholderText="What this snippet does" />

                                    <Grid Grid.Row="5" RowSpacing="5">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid ColumnSpacing="10">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                                Text="Content" />

                                            <StackPanel
                                                HorizontalAlignment="Right"
                                                Orientation="Horizontal"
                                                Spacing="4">
                                                <Button
                                                    Click="InsertCursor_Click"
                                                    Style="{StaticResource StudioIconButtonStyle}"
                                                    ToolTipService.ToolTip="Insert the final caret position">
                                                    <TextBlock
                                                        FontFamily="{StaticResource StudioMonoFont}"
                                                        FontSize="10"
                                                        Text="${cursor}" />
                                                </Button>
                                                <Button
                                                    Click="InsertPlaceholder_Click"
                                                    Style="{StaticResource StudioIconButtonStyle}"
                                                    ToolTipService.ToolTip="Insert a selected placeholder">
                                                    <TextBlock
                                                        FontFamily="{StaticResource StudioMonoFont}"
                                                        FontSize="10"
                                                        Text="${1:placeholder}" />
                                                </Button>
                                                <Button
                                                    Click="InsertPaste_Click"
                                                    Style="{StaticResource StudioIconButtonStyle}"
                                                    ToolTipService.ToolTip="Insert clipboard contents when expanded">
                                                    <TextBlock
                                                        FontFamily="{StaticResource StudioMonoFont}"
                                                        FontSize="10"
                                                        Text="${paste}" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <TextBox
                                            x:Name="ContentBox"
                                            Grid.Row="1"
                                            MinHeight="150"
                                            AcceptsReturn="True"
                                            AutomationProperties.Name="Snippet content"
                                            FontFamily="{StaticResource StudioMonoFont}"
                                            IsSpellCheckEnabled="False"
                                            PlaceholderText="SELECT * FROM ${cursor}"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                                            TextWrapping="Wrap"
                                            VerticalAlignment="Stretch" />
                                    </Grid>

                                    <TextBlock
                                        x:Name="EditorError"
                                        Grid.Row="6"
                                        FontSize="11"
                                        Foreground="{ThemeResource StudioDangerBrush}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />

                                    <Grid Grid.Row="7">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button
                                                x:Name="ResetButton"
                                                Click="ResetSnippet_Click"
                                                Content="Reset to default"
                                                Visibility="Collapsed" />
                                            <Button
                                                x:Name="DeleteButton"
                                                Click="DeleteSnippet_Click"
                                                Content="Delete"
                                                Visibility="Collapsed" />
                                        </StackPanel>

                                        <StackPanel
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal"
                                            Spacing="8">
                                            <Button
                                                Click="CancelEdit_Click"
                                                Content="Cancel" />
                                            <Button
                                                x:Name="SaveButton"
                                                Click="SaveSnippet_Click"
                                                Content="Save snippet"
                                                Style="{StaticResource AccentButtonStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!--  ============ ABOUT ============  -->
                <ScrollViewer
                    x:Name="AboutSection"
                    Visibility="Collapsed"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel
                        MaxWidth="680"
                        HorizontalAlignment="Left"
                        Spacing="10">
                        <TextBlock
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                            Text="Larik SQL Studio" />
                        <TextBlock
                            FontSize="12"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="A native Windows SQL studio for exploring databases and writing queries."
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="VersionText"
                            FontSize="12"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="Version 0.0.0" />

                        <!--  ============ UPDATES (GitHub edition only) ============  -->
                        <Border
                            x:Name="UpdatesCard"
                            Margin="0,8,0,0"
                            Padding="16"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="12">
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="3" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                            Text="Check for updates automatically" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{ThemeResource StudioTextMutedBrush}"
                                            Text="Larik checks GitHub Releases at launch. No workspace data or connection details are sent."
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <ToggleSwitch
                                        x:Name="CheckForUpdatesToggle"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Check for updates automatically"
                                        OffContent="Off"
                                        OnContent="On"
                                        Toggled="CheckForUpdatesToggle_Toggled" />
                                </Grid>

                                <Border
                                    Height="1"
                                    Background="{ThemeResource CardStrokeColorDefaultBrush}" />

                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="UpdateStatusText"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{ThemeResource StudioTextMutedBrush}"
                                        Text="A check runs once when Larik starts."
                                        TextWrapping="Wrap" />
                                    <Button
                                        x:Name="CheckNowButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        AutomationProperties.Name="Check for updates now"
                                        Click="CheckNow_Click"
                                        Content="Check now" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock
                            x:Name="ManagedUpdatesNote"
                            Margin="0,8,0,0"
                            FontSize="11"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="This copy is installed as a Windows package. Updates are delivered by the Microsoft Store."
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <TextBlock
                            Margin="0,12,0,0"
                            CharacterSpacing="120"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="LOCAL DATA" />

                        <Border
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    FontSize="11"
                                    Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                    Text="Workspaces, tabs and snippets are stored in this SQLite database:"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="DatabasePathText"
                                    FontFamily="{StaticResource StudioMonoFont}"
                                    FontSize="11"
                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                    IsTextSelectionEnabled="True"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,8,0,0"
                            Padding="12"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="4">
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                        Text="A local log of this session helps explain a crash. It never leaves this machine and never includes your SQL, cell values or credentials."
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="LogPathText"
                                        FontFamily="{StaticResource StudioMonoFont}"
                                        FontSize="11"
                                        Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="OpenLogFolderButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Open log folder"
                                    Click="OpenLogFolder_Click"
                                    Content="Open folder" />
                            </Grid>
                        </Border>

                        <TextBlock
                            FontSize="11"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="Snippets are scoped per database dialect. Built-in snippets can be edited or disabled but not deleted; custom snippets can be deleted."
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>

            </Grid>
        </NavigationView>
    </Grid>
</Page>

