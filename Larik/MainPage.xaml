<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Larik.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Larik.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Larik"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:Larik.Models"
    xmlns:vm="using:Larik.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="RunAccelerator_Invoked" />
        <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTabAccelerator_Invoked" />
        <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="ToggleSidebarAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ SIDEBAR: spaces + vertical tabs ============  -->
        <Border
            x:Name="Sidebar"
            Grid.Column="0"
            Width="252"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Visibility="{x:Bind ViewModel.SidebarVisibility, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Pane header: caption-height strip so the rail runs to the window edge  -->
                <Grid Grid.Row="0" Padding="8,0" ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button
                        Width="36"
                        Height="32"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Toggle sidebar"
                        Command="{x:Bind ViewModel.ToggleSidebarCommand}"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Toggle sidebar (Ctrl+B)">
                        <FontIcon FontSize="14" Glyph="&#xE700;" />
                    </Button>

                    <!--  Workspace switcher, beside the pane toggle  -->
                    <Button
                        x:Name="SpaceSwitcherButton"
                        Grid.Column="1"
                        Height="32"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Switch workspace"
                        Click="SpaceSwitcher_Click"
                        HorizontalContentAlignment="Stretch"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ActiveSpace.TooltipText, Mode=OneWay}">
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="{x:Bind ViewModel.ActiveSpace.AccentBrush, Mode=OneWay}" />

                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                Text="{x:Bind ViewModel.ActiveSpace.Name, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />

                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="8"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Glyph="&#xE70D;" />
                        </Grid>
                    </Button>
                </Grid>

                <!--  Database selector: the space's connection context  -->
                <Button
                    x:Name="DatabaseSelectorButton"
                    Grid.Row="1"
                    Margin="8,0,8,4"
                    Padding="8,7"
                    AutomationProperties.Name="Select database"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Style="{StaticResource StudioIconButtonStyle}"
                    ToolTipService.ToolTip="Switch database">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" ShouldConstrainToRootBounds="True">
                            <StackPanel MinWidth="288" Spacing="2">
                                <TextBlock
                                    Margin="10,6,10,4"
                                    CharacterSpacing="120"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="DATABASES" />

                                <ListView
                                    x:Name="DatabaseList"
                                    MaxHeight="300"
                                    Padding="0"
                                    AutomationProperties.Name="Databases"
                                    IsItemClickEnabled="True"
                                    ItemClick="DatabaseList_ItemClick"
                                    ItemsSource="{x:Bind ViewModel.ActiveSpace.Databases, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DatabaseViewModel">
                                            <Grid
                                                Height="46"
                                                Padding="10,0"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <StackPanel VerticalAlignment="Center" Spacing="1">
                                                    <TextBlock
                                                        FontSize="12"
                                                        FontWeight="{x:Bind NameWeight, Mode=OneWay}"
                                                        Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                                        Text="{x:Bind Name}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource StudioTextMutedBrush}"
                                                        Text="{x:Bind Summary}" />
                                                </StackPanel>

                                                <StackPanel
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Orientation="Horizontal"
                                                    Spacing="4">
                                                    <Ellipse
                                                        Width="6"
                                                        Height="6"
                                                        VerticalAlignment="Center"
                                                        Fill="{x:Bind StatusBrush}" />
                                                    <TextBlock
                                                        FontSize="10"
                                                        Foreground="{ThemeResource StudioTextMutedBrush}"
                                                        Text="{x:Bind StatusText}" />
                                                </StackPanel>

                                                <FontIcon
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource StudioAccentBrush}"
                                                    Glyph="&#xE73E;"
                                                    Visibility="{x:Bind CheckVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Button
                                    x:Name="NewDatabaseButton"
                                    Margin="0,2,0,0"
                                    Padding="10,7"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="New database"
                                    Click="NewDatabase_Click"
                                    Style="{StaticResource StudioIconButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="11" Glyph="&#xE710;" />
                                        <TextBlock FontSize="12" Text="New database" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Padding="4,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource HairlineSubtleBrush}"
                            CornerRadius="3">
                            <TextBlock
                                CharacterSpacing="60"
                                FontSize="8"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="DB" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock
                                FontSize="12"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                Text="{x:Bind ViewModel.ActiveSpace.ConnectedDatabaseText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="{x:Bind ViewModel.ActiveSpace.ConnectionLine, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Ellipse
                                Width="6"
                                Height="6"
                                VerticalAlignment="Center"
                                Fill="{x:Bind ViewModel.ActiveSpace.StatusBrush, Mode=OneWay}" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ActiveSpace.StatusText, Mode=OneWay}" />
                        </StackPanel>

                        <FontIcon
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            FontSize="8"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Glyph="&#xE70D;" />

                    </Grid>
                </Button>

                <!--  Section header  -->
                <Grid Grid.Row="2" Margin="18,8,12,2">
                    <TextBlock
                        VerticalAlignment="Center"
                        CharacterSpacing="120"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="TABS" />
                    <Button
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="New query tab"
                        Command="{x:Bind ViewModel.NewTabCommand}"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="New query (Ctrl+T)">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                    </Button>
                </Grid>

                <!--  Vertical tab list  -->
                <ListView
                    x:Name="TabsList"
                    Grid.Row="3"
                    Padding="0,0,0,8"
                    AutomationProperties.Name="Query tabs"
                    IsItemClickEnabled="True"
                    ItemClick="TabsList_ItemClick"
                    ItemContainerStyle="{StaticResource StudioTabItemStyle}"
                    ItemsSource="{x:Bind ViewModel.Tabs}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TabViewModel">
                            <Grid
                                Height="42"
                                Padding="0,0,4,0"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                Background="{x:Bind ActiveTintBrush, Mode=OneWay}"
                                CornerRadius="6"
                                PointerEntered="TabItem_PointerEntered"
                                PointerExited="TabItem_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Rectangle
                                    Width="2"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind AccentBrush}"
                                    Opacity="{x:Bind ActiveStripOpacity, Mode=OneWay}"
                                    RadiusX="1"
                                    RadiusY="1" />

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="{x:Bind TitleWeight, Mode=OneWay}"
                                        Foreground="{x:Bind local:MainPage.TabTitleBrush(IsActive), Mode=OneWay}"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource StudioTextMutedBrush}"
                                        Text="{x:Bind Subtitle, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Close tab"
                                    Click="TabClose_Click"
                                    Style="{StaticResource StudioIconButtonStyle}"
                                    ToolTipService.ToolTip="Close tab"
                                    Visibility="{x:Bind CloseButtonVisibility, Mode=OneWay}">
                                    <FontIcon FontSize="9" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>

        <!--  ============ MAIN: editor + results ============  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="EditorRow" Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="ResultsRow" Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Caption: drag region for the window, with the system caption buttons at the right  -->
            <TitleBar
                x:Name="AppTitleBar"
                Grid.Row="0"
                Title="Larik SQL Studio"
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="{x:Bind ViewModel.IsSidebarCollapsed, Mode=OneWay}"
                PaneToggleRequested="AppTitleBar_PaneToggleRequested">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                </TitleBar.IconSource>
            </TitleBar>

            <!--  Query toolbar  -->
            <Grid
                Grid.Row="1"
                Padding="16,4,12,8"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StudioTextPrimaryBrush}"
                        Text="{x:Bind ViewModel.ActiveTab.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <Border
                        Padding="7,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource HairlineSubtleBrush}"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse
                                Width="5"
                                Height="5"
                                VerticalAlignment="Center"
                                Fill="{x:Bind ViewModel.ActiveSpace.StatusBrush, Mode=OneWay}" />
                            <TextBlock
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ActiveSpace.ConnectedDatabaseText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="{x:Bind ViewModel.ActiveSpace.StatusText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <Button
                        Padding="10,5"
                        AutomationProperties.Name="Format query"
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CornerRadius="6"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Format query">
                        <TextBlock FontSize="11" Text="Format" />
                    </Button>

                    <Button
                        x:Name="RunButton"
                        Width="32"
                        Height="28"
                        Padding="0"
                        AutomationProperties.Name="Run query"
                        Background="{x:Bind ViewModel.ActiveSpace.AccentBrush, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RunCommand}"
                        CornerRadius="6"
                        Foreground="White"
                        ToolTipService.ToolTip="Run query (Ctrl+Enter)">
                        <FontIcon FontSize="11" Glyph="&#xE768;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  SQL editor  -->
            <Border
                Grid.Row="2"
                Margin="12,0,12,0"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <RichEditBox
                    x:Name="Editor"
                    Padding="14,12,14,12"
                    AcceptsReturn="True"
                    AutomationProperties.Name="SQL editor"
                    Background="Transparent"
                    BorderThickness="0"
                    DisabledFormattingAccelerators="All"
                    FontFamily="{StaticResource StudioMonoFont}"
                    FontSize="13"
                    IsSpellCheckEnabled="False"
                    IsTextPredictionEnabled="False"
                    LostFocus="Editor_LostFocus"
                    PlaceholderText="Type SQL — try  sel  then Tab"
                    PreviewKeyDown="Editor_PreviewKeyDown"
                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionChanged="Editor_SelectionChanged"
                    SelectionHighlightColor="{ThemeResource EditorSelectionBrush}"
                    TextChanged="Editor_TextChanged"
                    TextWrapping="NoWrap">
                    <!--
                        The control template paints its own fill on top of the card, including a
                        different fill when focused. Let the card surface own the background instead.
                    -->
                    <RichEditBox.Resources>
                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBackgroundDisabled" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                        <SolidColorBrush x:Key="TextControlBorderBrushDisabled" Color="Transparent" />
                    </RichEditBox.Resources>
                </RichEditBox>
            </Border>

            <!--  Drag handle between editor and results  -->
            <controls:DragHandle
                x:Name="Splitter"
                Grid.Row="3"
                Height="10"
                Background="Transparent"
                PointerMoved="Splitter_PointerMoved"
                PointerPressed="Splitter_PointerPressed"
                PointerReleased="Splitter_PointerReleased">
                <Border
                    Height="1"
                    VerticalAlignment="Center"
                    Margin="12,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </controls:DragHandle>

            <!--  Results  -->
            <Grid Grid.Row="4" Margin="12,0,12,0" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="4,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            CharacterSpacing="120"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="RESULTS" />
                        <TextBlock
                            x:Name="ResultMessageText"
                            FontSize="11"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
                </Grid>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ScrollViewer
                        x:Name="ResultsScroller"
                        AutomationProperties.Name="Query results"
                        HorizontalScrollBarVisibility="Auto"
                        Padding="0,2,0,0"
                        VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="ResultsHost" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!--  Status bar  -->
            <Grid
                Grid.Row="5"
                Padding="16,6,16,6"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Fill="{x:Bind ViewModel.ActiveSpace.StatusBrush, Mode=OneWay}" />
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.ActiveSpace.ConnectionLine, Mode=OneWay}" />
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="14"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="{x:Bind ViewModel.CaretText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!--  Completion popup (caret-anchored)  -->
        <Popup
            x:Name="CompletionPopup"
            IsLightDismissEnabled="False"
            ShouldConstrainToRootBounds="True">
            <Border
                Width="392"
                MaxHeight="268"
                Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <ListView
                    x:Name="CompletionList"
                    Padding="4"
                    AutomationProperties.Name="SQL suggestions"
                    IsItemClickEnabled="True"
                    IsTabStop="False"
                    ItemClick="CompletionList_ItemClick"
                    SelectionMode="None"
                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="models:CompletionItem">
                            <Grid
                                Height="32"
                                Padding="8,0"
                                AutomationProperties.HelpText="{x:Bind Detail}"
                                AutomationProperties.Name="{x:Bind Label}"
                                Background="{x:Bind HighlightBrush, Mode=OneWay}"
                                ColumnSpacing="8"
                                CornerRadius="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="{x:Bind KindLabel}" />

                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource StudioMonoFont}"
                                    FontSize="12"
                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                    Text="{x:Bind Label}" />

                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="{x:Bind Detail}"
                                    TextTrimming="CharacterEllipsis" />

                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    FontSize="9"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="Tab" />
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Border>
        </Popup>
    </Grid>
</Page>
