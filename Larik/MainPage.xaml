<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Larik.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Larik.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Larik"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Larik.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.Resources>
        <!--  Shared by the pinned section and the normal tab rail.  -->
        <DataTemplate x:Key="TabItemTemplate" x:DataType="vm:TabViewModel">
            <Grid
                Height="{x:Bind RowHeight, Mode=OneWay}"
                Padding="0,0,4,0"
                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                Background="{x:Bind ActiveTintBrush, Mode=OneWay}"
                ContextRequested="TabItem_ContextRequested"
                CornerRadius="6"
                DoubleTapped="TabItem_DoubleTapped"
                PointerEntered="TabItem_PointerEntered"
                PointerExited="TabItem_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Rectangle
                    Width="2"
                    Height="18"
                    VerticalAlignment="Center"
                    Fill="{x:Bind AccentBrush, Mode=OneWay}"
                    Opacity="{x:Bind ActiveStripOpacity, Mode=OneWay}"
                    RadiusX="1"
                    RadiusY="1" />

                <StackPanel
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Glyph="&#xE840;"
                            ToolTipService.ToolTip="Pinned"
                            Visibility="{x:Bind PinVisibility, Mode=OneWay}" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="{x:Bind TitleWeight, Mode=OneWay}"
                            Foreground="{x:Bind local:MainPage.TabTitleBrush(IsActive), Mode=OneWay}"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            Visibility="{x:Bind TitleVisibility, Mode=OneWay}" />

                        <TextBox
                            x:Name="TabTitleEditor"
                            Grid.Column="1"
                            Height="20"
                            MinHeight="0"
                            Padding="3,0"
                            VerticalAlignment="Center"
                            AutomationProperties.Name="Tab name"
                            Background="{ThemeResource HairlineSubtleBrush}"
                            BorderThickness="0"
                            CornerRadius="3"
                            FontSize="12"
                            IsSpellCheckEnabled="False"
                            KeyDown="TabTitleEditor_KeyDown"
                            LostFocus="TabTitleEditor_LostFocus"
                            Text="{x:Bind DraftTitle, Mode=OneWay}"
                            Visibility="{x:Bind RenameEditorVisibility, Mode=OneWay}" />
                    </Grid>
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="{x:Bind Subtitle, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" />
                </StackPanel>

                <Border
                    Grid.Column="2"
                    Margin="6,0,0,0"
                    Padding="5,1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind TransactionSummary, Mode=OneWay}"
                    BorderBrush="{x:Bind TransactionBrush, Mode=OneWay}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ToolTipService.ToolTip="{x:Bind TransactionSummary, Mode=OneWay}"
                    Visibility="{x:Bind TransactionBadgeVisibility, Mode=OneWay}">
                    <TextBlock
                        CharacterSpacing="40"
                        FontSize="8"
                        FontWeight="SemiBold"
                        Foreground="{x:Bind TransactionBrush, Mode=OneWay}"
                        Text="TXN" />
                </Border>

                <Button
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Close tab"
                    Click="TabClose_Click"
                    Style="{StaticResource StudioIconButtonStyle}"
                    ToolTipService.ToolTip="Close tab · kept in archive"
                    Visibility="{x:Bind CloseButtonVisibility, Mode=OneWay}">
                    <FontIcon FontSize="9" Glyph="&#xE711;" />
                </Button>
            </Grid>
        </DataTemplate>
        <!--  Workspace identity: the chosen icon, or the first letter until one is picked.  -->
        <DataTemplate x:Key="SpaceIconTemplate" x:DataType="vm:SpaceViewModel">
            <Grid Width="16" Height="16">
                <FontIcon
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="14"
                    Foreground="{ThemeResource StudioTextSecondaryBrush}"
                    Glyph="{x:Bind IconGlyph, Mode=OneWay}"
                    Opacity="{x:Bind IndicatorOpacity, Mode=OneWay}"
                    Visibility="{x:Bind IconGlyphVisibility, Mode=OneWay}" />
                <TextBlock
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    FontSize="9"
                    FontWeight="SemiBold"
                    Foreground="{ThemeResource StudioTextSecondaryBrush}"
                    Opacity="{x:Bind IndicatorOpacity, Mode=OneWay}"
                    Text="{x:Bind Monogram, Mode=OneWay}"
                    Visibility="{x:Bind MonogramVisibility, Mode=OneWay}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="RunStatementAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="RunAllAccelerator_Invoked" />
        <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTabAccelerator_Invoked" />
        <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="ToggleSidebarAccelerator_Invoked" />
        <KeyboardAccelerator Key="K" Modifiers="Control" Invoked="SchemaAccelerator_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="ToggleResultsAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="0" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ SIDEBAR: spaces + vertical tabs ============  -->
        <Border
            x:Name="Sidebar"
            Grid.Column="0"
            Width="252"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Visibility="{x:Bind ViewModel.SidebarVisibility, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Workspace identity: the switcher, and nothing else competing with the name  -->
                <Button
                    x:Name="SpaceSwitcherButton"
                    Grid.Row="0"
                    Height="36"
                    Margin="4,4,4,0"
                    Padding="10,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Switch workspace"
                    Click="SpaceSwitcher_Click"
                    Style="{StaticResource StudioIconButtonStyle}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.ActiveSpace.TooltipText, Mode=OneWay}">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ContentControl
                            VerticalAlignment="Center"
                            Content="{x:Bind ViewModel.ActiveSpace, Mode=OneWay}"
                            ContentTemplate="{StaticResource SpaceIconTemplate}"
                            IsHitTestVisible="False"
                            Padding="0" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                            Text="{x:Bind ViewModel.ActiveSpace.Name, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />

                        <FontIcon
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="8"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Glyph="&#xE70D;" />
                    </Grid>
                </Button>

                <!--  Connection state and its one action, on the line below the name it belongs to  -->
                <Grid
                    Grid.Row="1"
                    Margin="12,2,8,6"
                    ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid VerticalAlignment="Center" ColumnSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Ellipse
                            Width="5"
                            Height="5"
                            VerticalAlignment="Center"
                            Fill="{x:Bind ViewModel.ActiveSpace.StatusBrush, Mode=OneWay}" />
                        <TextBlock
                            Grid.Column="1"
                            FontSize="10"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="{x:Bind ViewModel.ActiveSpace.StatusHeadline, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind ViewModel.ActiveSpace.ConnectionLine, Mode=OneWay}" />
                    </Grid>

                    <!--  A toggle, not two buttons: the label is the state transition, the tooltip the outcome.  -->
                    <Button
                        x:Name="ConnectionToggleButton"
                        Grid.Column="1"
                        Padding="8,2"
                        AutomationProperties.Name="{x:Bind ViewModel.ActiveSpace.Connection.ConnectionActionLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleConnectionCommand}"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Connect or disconnect this workspace">
                        <Grid>
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioAccentBrush}"
                                Text="Connect"
                                Visibility="{x:Bind ViewModel.ActiveSpace.ConnectActionVisibility, Mode=OneWay}" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="Disconnect"
                                Visibility="{x:Bind ViewModel.ActiveSpace.DisconnectActionVisibility, Mode=OneWay}" />
                        </Grid>
                    </Button>
                </Grid>

                <!--  Database selector and its schema browse action share one row  -->
                <Grid
                    Grid.Row="2"
                    Margin="8,0,8,4"
                    ColumnSpacing="4"
                    Visibility="{x:Bind ViewModel.ActiveSpace.DatabasePickerVisibility, Mode=OneWay}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Button
                        x:Name="DatabaseSelectorButton"
                        Padding="8,7"
                        AutomationProperties.Name="Select database"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Switch database">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" ShouldConstrainToRootBounds="True">
                            <StackPanel MinWidth="288" Spacing="2">
                                <TextBlock
                                    Margin="10,6,10,4"
                                    CharacterSpacing="120"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="DATABASES" />

                                <ListView
                                    x:Name="DatabaseList"
                                    MaxHeight="300"
                                    Padding="0"
                                    AutomationProperties.Name="Databases"
                                    IsItemClickEnabled="True"
                                    ItemClick="DatabaseList_ItemClick"
                                    ItemsSource="{x:Bind ViewModel.ActiveSpace.Databases, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DatabaseViewModel">
                                            <Grid
                                                Height="40"
                                                Padding="10,0"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="{x:Bind NameWeight, Mode=OneWay}"
                                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <FontIcon
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource StudioAccentBrush}"
                                                    Glyph="&#xE73E;"
                                                    Visibility="{x:Bind CheckVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Padding="4,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource HairlineSubtleBrush}"
                            CornerRadius="3">
                            <TextBlock
                                CharacterSpacing="60"
                                FontSize="8"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="DB" />
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                            Text="{x:Bind ViewModel.ActiveSpace.ConnectedDatabaseText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />

                        <FontIcon
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="8"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Glyph="&#xE70D;" />

                    </Grid>
                    </Button>

                    <Button
                        x:Name="BrowseSchemaButton"
                        Grid.Column="1"
                        Width="32"
                        Padding="0"
                        AutomationProperties.Name="Browse schema"
                        Click="BrowseSchema_Click"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Browse schema (Ctrl+K)">
                        <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                    </Button>
                </Grid>

                <!--  Pinned tabs: their own section above the TABS header, like Arc.  -->
                <ListView
                    x:Name="PinnedTabsList"
                    Grid.Row="3"
                    MaxHeight="220"
                    Padding="0,4,0,2"
                    AllowDrop="True"
                    AutomationProperties.Name="Pinned tabs"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DragItemsCompleted="PinnedTabsList_DragItemsCompleted"
                    IsItemClickEnabled="True"
                    ItemClick="TabsList_ItemClick"
                    ItemContainerStyle="{StaticResource StudioTabItemStyle}"
                    ItemTemplate="{StaticResource TabItemTemplate}"
                    ItemsSource="{x:Bind ViewModel.PinnedTabs}"
                    ReorderMode="Enabled"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    SelectionMode="None"
                    Visibility="{x:Bind ViewModel.PinnedTabsVisibility, Mode=OneWay}" />

                <!--  Section header  -->
                <Grid Grid.Row="4" Margin="18,6,12,2">
                    <TextBlock
                        VerticalAlignment="Center"
                        CharacterSpacing="120"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="TABS" />
                    <Button
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="Archive"
                        Command="{x:Bind ViewModel.OpenArchiveCommand}"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Archive">
                        <FontIcon FontSize="12" Glyph="&#xE81C;" />
                    </Button>
                </Grid>

                <!--  New tab is a row, not a small + in the header (Arc's rail).  -->
                <Button
                    Grid.Row="5"
                    Height="38"
                    Margin="4,0,4,2"
                    Padding="10,0"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    AutomationProperties.Name="New query tab"
                    Command="{x:Bind ViewModel.NewTabCommand}"
                    Style="{StaticResource StudioIconButtonStyle}"
                    ToolTipService.ToolTip="New query (Ctrl+T)">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <FontIcon
                            VerticalAlignment="Center"
                            FontSize="12"
                            Glyph="&#xE710;" />

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                            Text="New tab" />

                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="Ctrl+T" />
                    </Grid>
                </Button>

                <!--  Unpinned vertical tab list  -->
                <ListView
                    x:Name="TabsList"
                    Grid.Row="6"
                    Padding="0,0,0,8"
                    AllowDrop="True"
                    AutomationProperties.Name="Query tabs"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DragItemsCompleted="TabsList_DragItemsCompleted"
                    IsItemClickEnabled="True"
                    ItemClick="TabsList_ItemClick"
                    ItemContainerStyle="{StaticResource StudioTabItemStyle}"
                    ItemTemplate="{StaticResource TabItemTemplate}"
                    ItemsSource="{x:Bind ViewModel.UnpinnedTabs}"
                    ReorderMode="Enabled"
                    SelectionMode="None" />

                <!--  Workspace footer: up to six icons, then a position pill. Ten unlabelled marks
                      identify nothing, so past six the footer stops being a map and opens the
                      labelled list instead. Both rows switch workspaces.  -->
                <Grid
                    Grid.Row="7"
                    Padding="8,7,8,7"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--  App settings belong to the shell, not to the query being edited.  -->
                    <Button
                        x:Name="SettingsButton"
                        Width="28"
                        Height="24"
                        Padding="0"
                        AutomationProperties.Name="Settings"
                        Click="Settings_Click"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Settings">
                        <FontIcon FontSize="12" Glyph="&#xE713;" />
                    </Button>

                    <Grid Grid.Column="1">
                        <ItemsControl
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Workspaces"
                            ItemsSource="{x:Bind ViewModel.FooterSpaces, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.FooterIconsVisibility, Mode=OneWay}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpaceViewModel">
                                    <Button
                                        Width="26"
                                        Height="24"
                                        Padding="0"
                                        AutomationProperties.Name="{x:Bind IndicatorName, Mode=OneWay}"
                                        Background="{x:Bind IndicatorChipBrush, Mode=OneWay}"
                                        Click="WorkspaceIndicator_Click"
                                        Content="{x:Bind}"
                                        ContentTemplate="{StaticResource SpaceIconTemplate}"
                                        CornerRadius="6"
                                        Style="{StaticResource StudioIconButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <StackPanel
                            HorizontalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="2"
                            Visibility="{x:Bind ViewModel.FooterPillVisibility, Mode=OneWay}">
                            <Button
                                Width="20"
                                Height="24"
                                Padding="0"
                                AutomationProperties.Name="Previous workspace"
                                Click="WorkspacePrevious_Click"
                                IsEnabled="{x:Bind ViewModel.CanGoToPreviousSpace, Mode=OneWay}"
                                Style="{StaticResource StudioIconButtonStyle}"
                                ToolTipService.ToolTip="Previous workspace">
                                <FontIcon FontSize="9" Glyph="&#xE76B;" />
                            </Button>

                            <Button
                                Width="24"
                                Height="24"
                                Padding="0"
                                AutomationProperties.HelpText="Opens the workspace list"
                                AutomationProperties.Name="{x:Bind ViewModel.ActiveSpace.IndicatorName, Mode=OneWay}"
                                Background="{x:Bind ViewModel.ActiveSpace.IndicatorChipBrush, Mode=OneWay}"
                                Click="WorkspacePill_Click"
                                Content="{x:Bind ViewModel.ActiveSpace, Mode=OneWay}"
                                ContentTemplate="{StaticResource SpaceIconTemplate}"
                                CornerRadius="6"
                                Style="{StaticResource StudioIconButtonStyle}"
                                ToolTipService.ToolTip="Switch workspace" />

                            <Button
                                Width="20"
                                Height="24"
                                Padding="0"
                                AutomationProperties.Name="Next workspace"
                                Click="WorkspaceNext_Click"
                                IsEnabled="{x:Bind ViewModel.CanGoToNextSpace, Mode=OneWay}"
                                Style="{StaticResource StudioIconButtonStyle}"
                                ToolTipService.ToolTip="Next workspace">
                                <FontIcon FontSize="9" Glyph="&#xE76C;" />
                            </Button>

                            <TextBlock
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="10"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="{x:Bind ViewModel.WorkspacePositionText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <!--  Balances the settings button so the icons stay centred in the rail.  -->
                    <Border
                        Grid.Column="2"
                        Width="28"
                        IsHitTestVisible="False" />
                </Grid>
            </Grid>
        </Border>

        <!--  Pinned schema inspector: the peek's docked form, off until pinned.  -->
        <Border
            x:Name="SchemaPinnedHost"
            Grid.Column="1"
            Width="300"
            Background="{ThemeResource PanelBackgroundBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Visibility="Collapsed">
            <controls:SchemaBrowser x:Name="SchemaPinned" Compact="True" />
        </Border>

        <!--  ============ MAIN: editor + results ============  -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="EditorRow" Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="ResultsRow" Height="0" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Caption: drag region for the window, with the system caption buttons at the right  -->
            <TitleBar
                x:Name="AppTitleBar"
                Grid.Row="0"
                Title="Larik SQL Studio"
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="True"
                PaneToggleRequested="AppTitleBar_PaneToggleRequested">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                </TitleBar.IconSource>
            </TitleBar>

            <!--  Query toolbar  -->
            <Grid
                x:Name="QueryToolbar"
                Grid.Row="1"
                Padding="16,4,12,8"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StudioTextPrimaryBrush}"
                        Text="{x:Bind ViewModel.ActiveTab.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <Button
                        x:Name="ContextBadgeButton"
                        Padding="8,2"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Workspace and connection"
                        Background="{ThemeResource HairlineSubtleBrush}"
                        Click="ContextBadge_Click"
                        CornerRadius="10"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ActiveSpace.ConnectionLine, Mode=OneWay}"
                        Visibility="{x:Bind ViewModel.ContextBadgeVisibility, Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <!--  With the rail hidden this badge is the only place the workspace shows.  -->
                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{x:Bind ViewModel.ActiveSpace, Mode=OneWay}"
                                ContentTemplate="{StaticResource SpaceIconTemplate}"
                                IsHitTestVisible="False"
                                Padding="0" />
                            <Ellipse
                                Width="5"
                                Height="5"
                                VerticalAlignment="Center"
                                Fill="{x:Bind ViewModel.ActiveSpace.StatusBrush, Mode=OneWay}" />
                            <TextBlock
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ActiveSpace.ContextBadgeText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <Button
                        Padding="10,5"
                        AutomationProperties.Name="Format query"
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CornerRadius="6"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Format query">
                        <TextBlock FontSize="11" Text="Format" />
                    </Button>

                    <Button
                        x:Name="RunButton"
                        Width="32"
                        Height="28"
                        Padding="0"
                        AutomationProperties.Name="Run query"
                        Background="{x:Bind ViewModel.ActiveSpace.AccentBrush, Mode=OneWay}"
                        Click="RunButton_Click"
                        CornerRadius="6"
                        Foreground="{ThemeResource StudioOnAccentBrush}"
                        IsEnabled="{x:Bind ViewModel.ActiveTab.CanRun, Mode=OneWay}"
                        ToolTipService.ToolTip="Run statement (Ctrl+Enter) · F5 runs all">
                        <FontIcon FontSize="11" Glyph="&#xE768;" />
                    </Button>

                    <Button
                        x:Name="StopButton"
                        Width="32"
                        Height="28"
                        Padding="0"
                        AutomationProperties.Name="Stop query"
                        Command="{x:Bind ViewModel.CancelRunCommand}"
                        CornerRadius="6"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Stop the running query"
                        Visibility="{x:Bind ViewModel.ActiveTab.IsRunningVisibility, Mode=OneWay}">
                        <FontIcon
                            FontSize="11"
                            Foreground="{ThemeResource StudioDangerBrush}"
                            Glyph="&#xE71A;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  SQL editor: an IEditorSurface implementation; swap it for a WebView2/Monaco island without touching the shell.  -->
            <controls:SqlEditorView x:Name="SqlEditor" Grid.Row="2" Margin="12,0,12,0" />
            <!--  Drag handle between editor and results  -->
            <controls:DragHandle
                x:Name="Splitter"
                Grid.Row="3"
                Height="10"
                Background="Transparent"
                PointerMoved="Splitter_PointerMoved"
                PointerPressed="Splitter_PointerPressed"
                PointerReleased="Splitter_PointerReleased"
                Visibility="Collapsed">
                <Border
                    Height="1"
                    VerticalAlignment="Center"
                    Margin="12,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </controls:DragHandle>

            <!--  Results  -->
            <Grid
                x:Name="ResultsPane"
                Grid.Row="4"
                Margin="12,0,12,0"
                RowSpacing="6"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Result tabs for a batch: one per result set, reorderable like query tabs.  -->
                <ListView
                    x:Name="ResultTabsList"
                    Grid.Row="1"
                    Padding="0"
                    AllowDrop="True"
                    AutomationProperties.Name="Result tabs"
                    CanDragItems="True"
                    CanReorderItems="True"
                    DragItemsCompleted="ResultTabsList_DragItemsCompleted"
                    IsItemClickEnabled="True"
                    ItemClick="ResultTab_ItemClick"
                    ItemsSource="{x:Bind ViewModel.Results}"
                    ReorderMode="Enabled"
                    SelectionMode="None"
                    ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                    ScrollViewer.HorizontalScrollMode="Enabled"
                    ScrollViewer.VerticalScrollBarVisibility="Disabled"
                    ScrollViewer.VerticalScrollMode="Disabled"
                    Visibility="{x:Bind ViewModel.ResultTabsVisibility, Mode=OneWay}">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>
                    <ListView.ItemContainerStyle>
                        <!--  Tabs hug their content; the strip scrolls horizontally.  -->
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:ResultSetViewModel">
                            <Border
                                Margin="0,0,2,0"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                Background="{x:Bind TabBackground, Mode=OneWay}"
                                CornerRadius="6"
                                ToolTipService.ToolTip="{x:Bind Tooltip, Mode=OneWay}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel
                                        Padding="9,3"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal"
                                        Spacing="6">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="{x:Bind TitleWeight, Mode=OneWay}"
                                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                            Text="{x:Bind Title, Mode=OneWay}" />
                                        <TextBlock
                                            MaxWidth="120"
                                            FontSize="10"
                                            Foreground="{x:Bind DetailBrush, Mode=OneWay}"
                                            Text="{x:Bind Detail, Mode=OneWay}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <Button
                                        Grid.Column="1"
                                        Padding="6,3"
                                        AutomationProperties.Name="{x:Bind CloseName, Mode=OneWay}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Click="ResultTabClose_Click"
                                        ToolTipService.ToolTip="Close result">
                                        <FontIcon FontSize="9" Glyph="&#xE711;" />
                                    </Button>

                                    <Rectangle
                                        Grid.ColumnSpan="2"
                                        Width="2"
                                        Height="14"
                                        HorizontalAlignment="Left"
                                        IsHitTestVisible="False"
                                        VerticalAlignment="Center"
                                        Fill="{x:Bind AccentBrush, Mode=OneWay}"
                                        Opacity="{x:Bind ActiveStripOpacity, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Grid.Row="0" Padding="4,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            CharacterSpacing="120"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="RESULTS" />
                        <TextBlock
                            x:Name="ResultMessageText"
                            FontSize="11"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
                </Grid>

                <Border
                    Grid.Row="2"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <controls:ResultsGrid x:Name="ResultsGrid" StatusChanged="ResultsGrid_StatusChanged" />
                </Border>
            </Grid>

            <!--  Status bar  -->
            <Grid
                Grid.Row="5"
                Padding="16,6,16,6"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="10"
                    Foreground="{ThemeResource StudioTextSecondaryBrush}"
                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="14"
                    VerticalAlignment="Center">
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        VerticalAlignment="Center"
                        Visibility="{x:Bind ViewModel.ActiveTab.TransactionGuardVisibility, Mode=OneWay}">
                        <Ellipse
                            Width="6"
                            Height="6"
                            VerticalAlignment="Center"
                            Fill="{x:Bind ViewModel.ActiveTab.TransactionBrush, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="10"
                            Foreground="{x:Bind ViewModel.ActiveTab.TransactionBrush, Mode=OneWay}"
                            Text="{x:Bind ViewModel.ActiveTab.TransactionSummary, Mode=OneWay}" />
                        <Button
                            Padding="8,1"
                            AutomationProperties.Name="Commit transaction"
                            Command="{x:Bind ViewModel.CommitTransactionCommand}"
                            IsEnabled="{x:Bind ViewModel.ActiveTab.CanCommit, Mode=OneWay}"
                            Style="{StaticResource StudioIconButtonStyle}"
                            ToolTipService.ToolTip="Commit the open transaction">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioSuccessBrush}"
                                Text="Commit" />
                        </Button>
                        <Button
                            Padding="8,1"
                            AutomationProperties.Name="Roll back transaction"
                            Command="{x:Bind ViewModel.RollbackTransactionCommand}"
                            IsEnabled="{x:Bind ViewModel.ActiveTab.CanRollback, Mode=OneWay}"
                            Style="{StaticResource StudioIconButtonStyle}"
                            ToolTipService.ToolTip="Roll back the open transaction">
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioDangerBrush}"
                                Text="Roll back" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="{x:Bind ViewModel.CaretText, Mode=OneWay}" />
                </StackPanel>
            </Grid>

            <!--  ============ ARCHIVE / HISTORY PAGE ============  -->
            <Grid
                x:Name="ArchivePage"
                Grid.Row="1"
                Grid.RowSpan="5"
                Padding="24,12,24,18"
                Background="{ThemeResource StudioBackgroundBrush}"
                RowSpacing="14"
                Visibility="{x:Bind ViewModel.ArchiveVisibility, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="12">
                    <StackPanel
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            AutomationProperties.Name="Back to workspace"
                            Command="{x:Bind ViewModel.CloseArchiveCommand}"
                            Style="{StaticResource StudioIconButtonStyle}"
                            ToolTipService.ToolTip="Back to workspace">
                            <FontIcon FontSize="11" Glyph="&#xE72B;" />
                        </Button>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                            Text="Archive" />
                        <Border
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="{ThemeResource HairlineSubtleBrush}"
                            CornerRadius="10">
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ArchiveCountLabel, Mode=OneWay}" />
                        </Border>
                    </StackPanel>

                    <StackPanel
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Orientation="Horizontal"
                        Spacing="6">
                        <TextBox
                            x:Name="ArchiveSearchBox"
                            Width="220"
                            AutomationProperties.Name="Search archive"
                            PlaceholderText="Search history"
                            TextChanged="ArchiveSearch_TextChanged" />
                        <Button
                            Padding="10,5"
                            AutomationProperties.Name="Clear archive"
                            Click="ArchiveClearAll_Click"
                            Style="{StaticResource StudioIconButtonStyle}"
                            ToolTipService.ToolTip="Delete every archived tab"
                            Visibility="{x:Bind ViewModel.ArchiveClearVisibility, Mode=OneWay}">
                            <TextBlock FontSize="11" Text="Clear all" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!--  Auto-archive controls: the n in "archive after n days".  -->
                <Border
                    Grid.Row="1"
                    Padding="14,10"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleSwitch
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Auto archive inactive tabs"
                                IsOn="{x:Bind ViewModel.AutoArchiveEnabled, Mode=TwoWay}"
                                OffContent="Auto-archive"
                                OnContent="Auto-archive" />

                            <NumberBox
                                Grid.Column="1"
                                Width="110"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Archive after days"
                                LargeChange="5"
                                Maximum="3650"
                                Minimum="1"
                                SmallChange="1"
                                SpinButtonPlacementMode="Compact"
                                Value="{x:Bind ViewModel.AutoArchiveDays, Mode=TwoWay}" />

                            <TextBlock
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Text="days without use" />

                            <Button
                                Grid.Column="3"
                                Padding="10,5"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="Archive inactive tabs now"
                                Command="{x:Bind ViewModel.ArchiveInactiveNowCommand}"
                                Style="{StaticResource StudioIconButtonStyle}"
                                ToolTipService.ToolTip="Run the inactivity sweep now">
                                <TextBlock FontSize="11" Text="Run now" />
                            </Button>
                        </Grid>

                        <TextBlock
                            FontSize="10"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="{x:Bind ViewModel.AutoArchiveDescription, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <ListView
                        x:Name="ArchivedTabsList"
                        Padding="0"
                        AutomationProperties.Name="Archived tabs"
                        ItemsSource="{x:Bind ViewModel.VisibleArchivedTabs}"
                        SelectionMode="None">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,6" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="vm:ArchivedTabViewModel">
                                <Border
                                    Padding="14,10"
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <Rectangle
                                            Width="2"
                                            Height="38"
                                            VerticalAlignment="Center"
                                            Fill="{x:Bind AccentBrush}"
                                            RadiusX="1"
                                            RadiusY="1" />

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="2">
                                            <Grid ColumnSpacing="6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <FontIcon
                                                    VerticalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                                    Glyph="&#xE840;"
                                                    ToolTipService.ToolTip="Pinned"
                                                    Visibility="{x:Bind PinVisibility}" />

                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="12"
                                                    FontWeight="SemiBold"
                                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                                    Text="{x:Bind Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                            <TextBlock
                                                FontSize="10"
                                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                                Text="{x:Bind ContextLine}"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontFamily="{StaticResource StudioMonoFont}"
                                                FontSize="11"
                                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                                Text="{x:Bind Preview}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>

                                        <TextBlock
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="10"
                                            Foreground="{ThemeResource StudioTextMutedBrush}"
                                            Text="{x:Bind AgeLabel}" />

                                        <StackPanel
                                            Grid.Column="3"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal"
                                            Spacing="4">
                                            <Button
                                                Padding="10,5"
                                                AutomationProperties.Name="{x:Bind RestoreName}"
                                                Click="ArchiveRestore_Click"
                                                Style="{StaticResource StudioIconButtonStyle}"
                                                ToolTipService.ToolTip="Restore this tab">
                                                <TextBlock FontSize="11" Text="Restore" />
                                            </Button>
                                            <Button
                                                Padding="7,5"
                                                AutomationProperties.Name="{x:Bind DeleteName}"
                                                Click="ArchiveDelete_Click"
                                                Style="{StaticResource StudioIconButtonStyle}"
                                                ToolTipService.ToolTip="Delete from archive">
                                                <FontIcon FontSize="10" Glyph="&#xE74D;" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <StackPanel
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="6"
                        Visibility="{x:Bind ViewModel.ArchiveEmptyVisibility, Mode=OneWay}">
                        <FontIcon
                            HorizontalAlignment="Center"
                            FontSize="26"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Glyph="&#xE81C;" />
                        <TextBlock
                            HorizontalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextSecondaryBrush}"
                            Text="No archived tabs" />
                        <TextBlock
                            MaxWidth="360"
                            HorizontalAlignment="Center"
                            FontSize="11"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="Tabs you archive — or that auto-archive after their inactive days — are kept here. Pinned tabs are never auto-archived."
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>

        <!--  ============ NEW TAB COMMAND PALETTE ============  -->
        <Grid
            x:Name="NewTabPalette"
            Grid.ColumnSpan="3"
            Background="#66000000"
            KeyDown="NewTabPalette_KeyDown"
            Visibility="Collapsed">
            <Border Tapped="NewTabPaletteBackdrop_Tapped" />

            <Border
                Width="520"
                MaxHeight="460"
                Margin="0,96,0,0"
                Padding="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="10">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBox
                        x:Name="NewTabSearchBox"
                        AutomationProperties.Name="New tab database search"
                        KeyDown="NewTabSearchBox_KeyDown"
                        PlaceholderText="Search databases…"
                        TextChanged="NewTabSearchBox_TextChanged" />

                    <ListView
                        x:Name="NewTabDatabaseList"
                        Grid.Row="1"
                        MaxHeight="320"
                        Padding="0"
                        AutomationProperties.Name="New query database"
                        IsItemClickEnabled="True"
                        ItemClick="NewTabDatabaseList_ItemClick"
                        SelectionMode="Single">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="Padding" Value="10,7" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                    </ListView>

                    <TextBlock
                        x:Name="NewTabPaletteMessage"
                        Grid.Row="2"
                        FontSize="11"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                    <TextBlock
                        Grid.Row="3"
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="Type to filter · Enter opens · Esc closes" />
                </Grid>
            </Border>
        </Grid>

        <!--  ============ SCHEMA PEEK ============  -->
        <Grid
            x:Name="SchemaPeekHost"
            Grid.ColumnSpan="3"
            Background="#73000000"
            Visibility="Collapsed">
            <Border Tapped="SchemaPeekBackdrop_Tapped" />
            <Border
                Width="620"
                Height="520"
                Margin="264,108,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{ThemeResource PanelBackgroundBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="12">
                <controls:SchemaBrowser x:Name="SchemaPeek" />
            </Border>
        </Grid>

    </Grid>
</Page>
