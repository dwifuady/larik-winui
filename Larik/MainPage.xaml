<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="Larik.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Larik.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:Larik"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:Larik.ViewModels"
    Background="Transparent"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="Enter" Modifiers="Control" Invoked="RunAccelerator_Invoked" />
        <KeyboardAccelerator Key="T" Modifiers="Control" Invoked="NewTabAccelerator_Invoked" />
        <KeyboardAccelerator Key="B" Modifiers="Control" Invoked="ToggleSidebarAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  ============ SIDEBAR: spaces + vertical tabs ============  -->
        <Border
            x:Name="Sidebar"
            Grid.Column="0"
            Width="252"
            Background="Transparent"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,1,0"
            Visibility="{x:Bind ViewModel.SidebarVisibility, Mode=OneWay}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  Workspace switcher: full rail width; the pane toggle now lives in the title bar  -->
                <Grid Grid.Row="0" Padding="8,0">
                    <Button
                        x:Name="SpaceSwitcherButton"
                        Height="38"
                        Padding="10,0"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Switch workspace"
                        Click="SpaceSwitcher_Click"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.ActiveSpace.TooltipText, Mode=OneWay}">
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Ellipse
                                Width="10"
                                Height="10"
                                VerticalAlignment="Center"
                                Fill="{x:Bind ViewModel.ActiveSpace.AccentBrush, Mode=OneWay}" />

                            <!--  Name and the workspace's connection state  -->
                            <StackPanel
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Spacing="-1">
                                <TextBlock
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                    Text="{x:Bind ViewModel.ActiveSpace.Name, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Ellipse
                                        Width="5"
                                        Height="5"
                                        VerticalAlignment="Center"
                                        Fill="{x:Bind ViewModel.ActiveSpace.StatusBrush, Mode=OneWay}" />
                                    <TextBlock
                                        FontSize="9"
                                        Foreground="{ThemeResource StudioTextMutedBrush}"
                                        Text="{x:Bind ViewModel.ActiveSpace.StatusText, Mode=OneWay}" />
                                </StackPanel>
                            </StackPanel>

                            <FontIcon
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                FontSize="8"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Glyph="&#xE70D;" />
                        </Grid>
                    </Button>
                </Grid>

                <!--  Database selector: the space's connection context  -->
                <Button
                    x:Name="DatabaseSelectorButton"
                    Grid.Row="1"
                    Margin="8,0,8,4"
                    Padding="8,7"
                    AutomationProperties.Name="Select database"
                    IsEnabled="{x:Bind ViewModel.ActiveSpace.IsConnected, Mode=OneWay}"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch"
                    Style="{StaticResource StudioIconButtonStyle}"
                    ToolTipService.ToolTip="Switch database">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft" ShouldConstrainToRootBounds="True">
                            <StackPanel MinWidth="288" Spacing="2">
                                <TextBlock
                                    Margin="10,6,10,4"
                                    CharacterSpacing="120"
                                    FontSize="10"
                                    FontWeight="SemiBold"
                                    Foreground="{ThemeResource StudioTextMutedBrush}"
                                    Text="DATABASES" />

                                <ListView
                                    x:Name="DatabaseList"
                                    MaxHeight="300"
                                    Padding="0"
                                    AutomationProperties.Name="Databases"
                                    IsItemClickEnabled="True"
                                    ItemClick="DatabaseList_ItemClick"
                                    ItemsSource="{x:Bind ViewModel.ActiveSpace.Databases, Mode=OneWay}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DatabaseViewModel">
                                            <Grid
                                                Height="40"
                                                Padding="10,0"
                                                AutomationProperties.Name="{x:Bind Name}"
                                                ColumnSpacing="8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                                    VerticalAlignment="Center"
                                                    FontSize="12"
                                                    FontWeight="{x:Bind NameWeight, Mode=OneWay}"
                                                    Foreground="{ThemeResource StudioTextPrimaryBrush}"
                                                    Text="{x:Bind Name}"
                                                    TextTrimming="CharacterEllipsis" />

                                                <FontIcon
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{ThemeResource StudioAccentBrush}"
                                                    Glyph="&#xE73E;"
                                                    Visibility="{x:Bind CheckVisibility, Mode=OneWay}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>

                                <Button
                                    x:Name="ConnectionSettingsButton"
                                    Margin="0,2,0,0"
                                    Padding="10,7"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Left"
                                    AutomationProperties.Name="Connection settings"
                                    Click="ConnectionSettings_Click"
                                    Style="{StaticResource StudioIconButtonStyle}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon FontSize="11" Glyph="&#xE713;" />
                                        <TextBlock FontSize="12" Text="Connection settings…" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Padding="4,1"
                            VerticalAlignment="Center"
                            Background="{ThemeResource HairlineSubtleBrush}"
                            CornerRadius="3">
                            <TextBlock
                                CharacterSpacing="60"
                                FontSize="8"
                                FontWeight="SemiBold"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="DB" />
                        </Border>

                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextPrimaryBrush}"
                            Text="{x:Bind ViewModel.ActiveSpace.ConnectedDatabaseText, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />

                        <FontIcon
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontSize="8"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Glyph="&#xE70D;" />

                    </Grid>
                </Button>

                <!--  Section header  -->
                <Grid Grid.Row="2" Margin="18,8,12,2">
                    <TextBlock
                        VerticalAlignment="Center"
                        CharacterSpacing="120"
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="TABS" />
                    <Button
                        HorizontalAlignment="Right"
                        AutomationProperties.Name="New query tab"
                        Command="{x:Bind ViewModel.NewTabCommand}"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="New query (Ctrl+T)">
                        <FontIcon FontSize="12" Glyph="&#xE710;" />
                    </Button>
                </Grid>

                <!--  Vertical tab list  -->
                <ListView
                    x:Name="TabsList"
                    Grid.Row="3"
                    Padding="0,0,0,8"
                    AutomationProperties.Name="Query tabs"
                    IsItemClickEnabled="True"
                    ItemClick="TabsList_ItemClick"
                    ItemContainerStyle="{StaticResource StudioTabItemStyle}"
                    ItemsSource="{x:Bind ViewModel.Tabs}"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="vm:TabViewModel">
                            <Grid
                                Height="42"
                                Padding="0,0,4,0"
                                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                                Background="{x:Bind ActiveTintBrush, Mode=OneWay}"
                                CornerRadius="6"
                                PointerEntered="TabItem_PointerEntered"
                                PointerExited="TabItem_PointerExited">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Rectangle
                                    Width="2"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Fill="{x:Bind AccentBrush}"
                                    Opacity="{x:Bind ActiveStripOpacity, Mode=OneWay}"
                                    RadiusX="1"
                                    RadiusY="1" />

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Spacing="1">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="{x:Bind TitleWeight, Mode=OneWay}"
                                        Foreground="{x:Bind local:MainPage.TabTitleBrush(IsActive), Mode=OneWay}"
                                        Text="{x:Bind Title, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource StudioTextMutedBrush}"
                                        Text="{x:Bind Subtitle, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{x:Bind SubtitleVisibility, Mode=OneWay}" />
                                </StackPanel>

                                <Button
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Close tab"
                                    Click="TabClose_Click"
                                    Style="{StaticResource StudioIconButtonStyle}"
                                    ToolTipService.ToolTip="Close tab"
                                    Visibility="{x:Bind CloseButtonVisibility, Mode=OneWay}">
                                    <FontIcon FontSize="9" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <!--  Workspace indicator: one dot per workspace, the active one ringed. The row is also a switcher.  -->
                <Grid
                    Grid.Row="4"
                    Padding="12,8"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0">
                    <ScrollViewer
                        HorizontalContentAlignment="Center"
                        HorizontalScrollBarVisibility="Hidden"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <ItemsControl
                            HorizontalAlignment="Center"
                            AutomationProperties.Name="Workspaces"
                            ItemsSource="{x:Bind ViewModel.Spaces}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SpaceViewModel">
                                    <Button
                                        Width="26"
                                        Height="24"
                                        Padding="0"
                                        AutomationProperties.Name="{x:Bind IndicatorName, Mode=OneWay}"
                                        Click="WorkspaceIndicator_Click"
                                        Style="{StaticResource StudioIconButtonStyle}"
                                        ToolTipService.ToolTip="{x:Bind TooltipText, Mode=OneWay}">
                                        <Grid Width="16" Height="16">
                                            <Ellipse
                                                Width="15"
                                                Height="15"
                                                Stroke="{x:Bind AccentBrush}"
                                                StrokeThickness="1.5"
                                                Visibility="{x:Bind IndicatorRingVisibility, Mode=OneWay}" />
                                            <Ellipse
                                                Width="{x:Bind IndicatorDotSize, Mode=OneWay}"
                                                Height="{x:Bind IndicatorDotSize, Mode=OneWay}"
                                                Fill="{x:Bind AccentBrush}"
                                                Opacity="{x:Bind IndicatorDotOpacity, Mode=OneWay}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>
        </Border>

        <!--  ============ MAIN: editor + results ============  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="EditorRow" Height="2*" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="ResultsRow" Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--  Caption: drag region for the window, with the system caption buttons at the right  -->
            <TitleBar
                x:Name="AppTitleBar"
                Grid.Row="0"
                Title="Larik SQL Studio"
                IsBackButtonVisible="False"
                IsPaneToggleButtonVisible="True"
                PaneToggleRequested="AppTitleBar_PaneToggleRequested">
                <TitleBar.IconSource>
                    <ImageIconSource ImageSource="Assets/AppIcon.ico" />
                </TitleBar.IconSource>
            </TitleBar>

            <!--  Query toolbar  -->
            <Grid
                x:Name="QueryToolbar"
                Grid.Row="1"
                Padding="16,4,12,8"
                ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource StudioTextPrimaryBrush}"
                        Text="{x:Bind ViewModel.ActiveTab.Title, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />

                    <Border
                        Padding="7,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource HairlineSubtleBrush}"
                        CornerRadius="10">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse
                                Width="5"
                                Height="5"
                                VerticalAlignment="Center"
                                Fill="{x:Bind ViewModel.ActiveSpace.StatusBrush, Mode=OneWay}" />
                            <TextBlock
                                FontSize="10"
                                FontWeight="Medium"
                                Foreground="{ThemeResource StudioTextSecondaryBrush}"
                                Text="{x:Bind ViewModel.ActiveSpace.ConnectedDatabaseText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="10"
                                Foreground="{ThemeResource StudioTextMutedBrush}"
                                Text="{x:Bind ViewModel.ActiveSpace.StatusText, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="6"
                    VerticalAlignment="Center">
                    <Button
                        Padding="10,5"
                        AutomationProperties.Name="Format query"
                        Command="{x:Bind ViewModel.FormatCommand}"
                        CornerRadius="6"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Format query">
                        <TextBlock FontSize="11" Text="Format" />
                    </Button>

                    <Button
                        x:Name="RunButton"
                        Width="32"
                        Height="28"
                        Padding="0"
                        AutomationProperties.Name="Run query"
                        Background="{x:Bind ViewModel.ActiveSpace.AccentBrush, Mode=OneWay}"
                        Command="{x:Bind ViewModel.RunCommand}"
                        CornerRadius="6"
                        Foreground="White"
                        ToolTipService.ToolTip="Run query (Ctrl+Enter)">
                        <FontIcon FontSize="11" Glyph="&#xE768;" />
                    </Button>
                </StackPanel>
            </Grid>

            <!--  SQL editor: an IEditorSurface implementation; swap it for a WebView2/Monaco island without touching the shell.  -->
            <controls:SqlEditorView x:Name="SqlEditor" Grid.Row="2" Margin="12,0,12,0" />
            <!--  Drag handle between editor and results  -->
            <controls:DragHandle
                x:Name="Splitter"
                Grid.Row="3"
                Height="10"
                Background="Transparent"
                PointerMoved="Splitter_PointerMoved"
                PointerPressed="Splitter_PointerPressed"
                PointerReleased="Splitter_PointerReleased">
                <Border
                    Height="1"
                    VerticalAlignment="Center"
                    Margin="12,0"
                    Background="{ThemeResource DividerStrokeColorDefaultBrush}" />
            </controls:DragHandle>

            <!--  Results  -->
            <Grid
                x:Name="ResultsPane"
                Grid.Row="4"
                Margin="12,0,12,0"
                RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Padding="4,0,4,0">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock
                            CharacterSpacing="120"
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="RESULTS" />
                        <TextBlock
                            x:Name="ResultMessageText"
                            FontSize="11"
                            Foreground="{ThemeResource StudioTextMutedBrush}"
                            Text="{x:Bind ViewModel.ResultMessage, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <TextBlock
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="{x:Bind ViewModel.ResultSummary, Mode=OneWay}" />
                </Grid>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ScrollViewer
                        x:Name="ResultsScroller"
                        AutomationProperties.Name="Query results"
                        HorizontalScrollBarVisibility="Auto"
                        Padding="0,2,0,0"
                        VerticalScrollBarVisibility="Auto">
                        <Grid x:Name="ResultsHost" />
                    </ScrollViewer>
                </Border>
            </Grid>

            <!--  Status bar  -->
            <Grid
                Grid.Row="5"
                Padding="16,6,16,6"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse
                        Width="6"
                        Height="6"
                        VerticalAlignment="Center"
                        Fill="{x:Bind ViewModel.ActiveSpace.StatusBrush, Mode=OneWay}" />
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextSecondaryBrush}"
                        Text="{x:Bind ViewModel.ActiveSpace.ConnectionLine, Mode=OneWay}" />
                    <Button
                        x:Name="ConnectionToggleButton"
                        Padding="8,1"
                        AutomationProperties.Name="{x:Bind ViewModel.ActiveSpace.Connection.ConnectionActionLabel, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleConnectionCommand}"
                        Style="{StaticResource StudioIconButtonStyle}"
                        ToolTipService.ToolTip="Connect or disconnect this workspace">
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{ThemeResource StudioAccentBrush}"
                            Text="{x:Bind ViewModel.ActiveSpace.Connection.ConnectionActionLabel, Mode=OneWay}" />
                    </Button>
                </StackPanel>

                <StackPanel
                    HorizontalAlignment="Right"
                    Orientation="Horizontal"
                    Spacing="14"
                    VerticalAlignment="Center">
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
                    <TextBlock
                        FontSize="10"
                        Foreground="{ThemeResource StudioTextMutedBrush}"
                        Text="{x:Bind ViewModel.CaretText, Mode=OneWay}" />
                </StackPanel>
            </Grid>
        </Grid>

    </Grid>
</Page>
